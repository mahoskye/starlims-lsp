-- format --
/* sample login - old version;
:PARAMETERS sampleid, matrix, priority;
:DEFAULT priority, "N";
:DECLARE rows, status, ok, cnt, i, logrec;
:DEFAULT status, "LOGGED";

sampleid := AllTrim(sampleid);
matrix := Upper(matrix);
if Empty(sampleid);
:RETURN .F.;
:ENDIF;

rows := SQLExecute("select Status from LabSamples where SampleId = ?sampleid?");

:IF Len(rows) > 0;
	:RETURN .F.;
:ENDIF;

:BEGINCASE;
:CASE matrix = "W";
	priority := "H";
:CASE matrix = "S";
	priority := "N";
	:EXITCASE;
:OTHERWISE;
	priority := "L";
:ENDCASE;

ok := RunSQL("
    INSERT INTO LabSamples (
        SampleId, Matrix, Status
    )
    VALUES (
        ?sampleid?, ?matrix?, ?status?
    )
");

:IF .NOT. ok;
	ErrorMes("login", "insert failed");
	:RETURN .F.;
:ENDIF;

cnt := 0;

:FOR i := 1 :TO Len(matrix);
	cnt := cnt + 1;
:NEXT;

logrec := CreateUdObject();
logrec.sample := sampleid;
logrec:count := cnt;
WriteAudit(logrec);
DoProc("Notify", {sampleid, priority});
:RETURN .T.;

:PROCEDURE Notify;
	:PARAMETERS id, prio;
	:DECLARE msg;

	msg := "sample " + id + " logged with priority " + prio;
	UsrMes(msg);

	:IF prio = "H";
		UsrMes("high priority!");
	:ENDIF;

	:ERROR;
		ErrorMes("Notify", "notify failed");
:ENDPROC;

:PROCEDURE LookupMatrix;
	:PARAMETERS code;
	:PUBLIC lastmatrix;
	:DECLARE desc;

	:IF code = "";
		:RETURN "";
	:ENDIF;

	desc := LSearch("select Description from LabMatrices where Code = ?", "",, {code});

	:IF Empty(desc);
		:IF Len(code) > 1;
			desc := LookupMatrix(Left(code, 1));
		:ELSE;
			desc := "unknown";
		:ENDIF;
	:ENDIF;

	lastmatrix := code;

	:RETURN desc;
:ENDPROC;
