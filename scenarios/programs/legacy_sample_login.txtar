A legacy sample-login script written the way old code looks: lowercase
keywords and built-in names, no Hungarian prefixes, several statements
crammed on one line, ragged indentation, a :DEFAULT on a declared local,
string '=' comparisons, a direct procedure call, a dot property access,
?name? placeholders passed to RunSQL, a :BEGINCASE arm without :EXITCASE
and a legacy :ERROR handler. The formatter and many diagnostics act on
it together; the format section shows what the formatter alone repairs.
The second half adds a lookup procedure with a :PUBLIC flag, an
'= ""' test, a nested :IF chain that never indents and a call to a
legacy procedure by bare name.
-- input.ssl --
/* sample login - old version;
:parameters sampleid, matrix, priority;
:default priority, "N";
:declare rows, status, ok, cnt, i, logrec;
:default status, "LOGGED";

sampleid := alltrim(sampleid); matrix := upper(matrix);
if empty(sampleid); :return .f.; :endif;

rows := sqlexecute("select Status from LabSamples where SampleId = ?sampleid?");
:if len(rows) > 0
  :return .F.;
:endif;

:begincase;
:case matrix = "W";
   priority := "H";
:case matrix = "S";
   priority := "N";
   :exitcase;
:otherwise;
priority := "L";
:endcase;

ok := runsql("insert into LabSamples (SampleId, Matrix, Status) values (?sampleid?, ?matrix?, ?status?)");
  :if .not. ok; ErrorMes("login", "insert failed"); :return .f.; :endif;

cnt := 0;
:for i := 1 :to len(matrix);
cnt := cnt + 1;
:next;

logrec := CreateUdObject();
logrec.sample := sampleid;
logrec:count := cnt;
WriteAudit(logrec);
DoProc("Notify", {sampleid, priority});
:return .t.;

:procedure Notify;
:parameters id, prio;
:declare msg;
  msg := "sample " + id + " logged with priority " + prio;
    usrmes(msg);
	  :if prio = "H"
	UsrMes("high priority!");
	  :endif;
:error;
  ErrorMes("Notify", "notify failed");
:endproc;

:procedure LookupMatrix;
:parameters code;
:public lastmatrix;
:declare desc;
:if code = ""; :return ""; :endif;
desc := LSearch("select Description from LabMatrices where Code = ?", "", , {code});
:if empty(desc)
:if len(code) > 1
desc := LookupMatrix(left(code, 1));
:else
desc := "unknown";
:endif
:endif
lastmatrix := code;
:return desc;
:endproc;
