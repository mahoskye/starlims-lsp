A legacy report builder: procedures defined before the script's
:PARAMETERS, procedures called directly by name instead of through
DoProc, a :DECLARE after executable code, an empty :CATCH that swallows
errors, a :FINALLY holding a :RETURN, LSelect with its value array in the
connection position, string building with '+' and a hand-rolled
LimsString loop, and inconsistent keyword case throughout.
The second half adds a summary procedure that mixes :TRY and :ERROR in
one procedure, splices a value into SQL by concatenation inside the call
(sql_injection), selects '*', compares against "" with '=', and nests
IIF calls.
-- input.ssl --
:procedure header;
:parameters title;
:return "== " + title + " ==";
:endproc;

:procedure line;
:parameters cols;
:declare out, c;
out := "";
:for c := 1 :to len(cols);
out := out + limsstring(cols[c]) + ";";
:next;
:return out;
:endproc;

:PARAMETERS grp, fromdate;
:DECLARE rows, txt, i;
txt := header("Group " + grp);
rows := LSelect("select SampleId, Status, LoggedOn from LabSamples where LabGroup = ? and LoggedOn >= ?",, {grp, fromdate});
:DECLARE cnt;
cnt := 0;
:TRY;
:for i := 1 :to len(rows);
txt := txt + Chr(10) + line(rows[i]);
cnt++;
:next;
:CATCH;
:FINALLY;
:return txt;
:ENDTRY;
txt := txt + Chr(10) + "rows: " + limsstring(cnt);
:return txt;

:procedure summary;
:parameters grp;
:declare total, open, ratio, label;
:try;
total := LSearch("select count(*) from LabSamples where LabGroup = '" + grp + "'", 0);
open := LSearch("select count(*) from LabSamples where LabGroup = ? and Status = ?", 0,, {grp, "OPEN"});
:catch;
total := 0;
:endtry;
:if grp = "";
:return "no group";
:endif;
ratio := iif(total > 0, open / total, 0);
label := iif(ratio > 0.5, "busy", iif(ratio > 0.1, "normal", "quiet"));
:return grp + ": " + label;
:error;
ErrorMes("summary", "summary failed");
:endproc;

:procedure dump;
:parameters grp;
:declare all;
all := SQLExecute("select * from LabSamples where LabGroup = ?grp?");
:return len(all);
:endproc;
-- format --
:PROCEDURE header;
	:PARAMETERS title;
	:RETURN "== " + title + " ==";
:ENDPROC;

:PROCEDURE line;
	:PARAMETERS cols;
	:DECLARE out, c;
	out := "";
	:FOR c := 1 :TO Len(cols);
		out := out + LimsString(cols[c]) + ";";
	:NEXT;
	:RETURN out;
:ENDPROC;

:PARAMETERS grp, fromdate;
:DECLARE rows, txt, i;
txt := header("Group " + grp);
rows := LSelect("
    SELECT SampleId, Status, LoggedOn
    FROM LabSamples
    WHERE LabGroup = ?
      AND LoggedOn >= ?
",, {grp, fromdate});
:DECLARE cnt;
cnt := 0;
:TRY;
	:FOR i := 1 :TO Len(rows);
		txt := txt + Chr(10) + line(rows[i]);
		cnt++;
	:NEXT;
:CATCH;
:FINALLY;
	:RETURN txt;
:ENDTRY;
txt := txt + Chr(10) + "rows: " + LimsString(cnt);
:RETURN txt;

:PROCEDURE summary;
	:PARAMETERS grp;
	:DECLARE total, open, ratio, label;
	:TRY;
		total := LSearch("select count(*) from LabSamples where LabGroup = '" + grp + "'",
		                 0);
		open := LSearch("
		    SELECT COUNT(*)
		    FROM LabSamples
		    WHERE LabGroup = ?
		      AND Status = ?
		", 0,, {grp, "OPEN"});
	:CATCH;
		total := 0;
	:ENDTRY;

	:IF grp = "";
		:RETURN "no group";
	:ENDIF;
	ratio := IIf(total > 0, open / total, 0);
	label := IIf(ratio > 0.5, "busy", IIf(ratio > 0.1, "normal", "quiet"));
	:RETURN grp + ": " + label;
	:ERROR;
		ErrorMes("summary", "summary failed");
:ENDPROC;

:PROCEDURE dump;
	:PARAMETERS grp;
	:DECLARE all;
	all := SQLExecute("select * from LabSamples where LabGroup = ?grp?");
	:RETURN Len(all);
:ENDPROC;
