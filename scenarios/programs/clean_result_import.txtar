A complete import script written to AGENTS.md conventions: a dataset
fetched with SQLExecute(..., "dataset") wrapped in SSLDataset{}, a
:WHILE loop over its rows, a user-defined result object from
CreateUdObject("Category.Class"), an anonymous object seeded with
properties, ExecFunction for an external validator, and TRY/CATCH/FINALLY.
Expected nearly clean under every profile.
-- input.ssl --
/*
 * Script: ResultImport
 * Description: Copies instrument readings for one run into the results table
 * Parameters:
 *   sRunId - the instrument run to import
 * Returns: an import summary object
;
:PARAMETERS sRunId;
:DEFAULT sRunId, "";
:DECLARE oSummary, oData, oDataset, aRows, nRow, oReading, bValid, oErr;

oSummary := CreateUdObject("Lab.ImportSummary", {sRunId});
:IF Empty(sRunId);
	oSummary:message := "A run identifier is required";
	:RETURN oSummary;
:ENDIF;

:TRY;
	oData := SQLExecute("SELECT ReadingId, SampleId, Analyte, Value FROM InstrumentReadings WHERE RunId = ?sRunId?",,,,, "dataset");
	oDataset := SSLDataset{oData, .T.};
	aRows := oDataset:ToArray();

	nRow := 1;
	:WHILE nRow <= Len(aRows);
		oReading := DoProc("ToReading", {aRows[nRow]});
		bValid := ExecFunction("Lab.ReadingRules.Validate", {oReading});
		:IF bValid;
			DoProc("SaveReading", {oReading});
			oSummary:imported += 1;
		:ELSE;
			oSummary:rejected += 1;
		:ENDIF;
		nRow += 1;
	:ENDWHILE;
	oSummary:message := "Import finished";
:CATCH;
	oErr := GetLastSSLError();
	oSummary:message := "Import failed: " + oErr:Description;
:FINALLY;
	oSummary:finishedOn := Now();
:ENDTRY;

:RETURN oSummary;

/*
 * Procedure: ToReading
 * Parameters:
 *   aRow - one dataset row {ReadingId, SampleId, Analyte, Value}
 * Returns: an anonymous reading object
;
:PROCEDURE ToReading;
	:PARAMETERS aRow;
	:DECLARE oReading;
	oReading := CreateUdObject({{"readingId", aRow[1]}, {"sampleId", aRow[2]}});
	oReading:analyte := AllTrim(aRow[3]);
	oReading:value := Val(LimsString(aRow[4]));
	:RETURN oReading;
:ENDPROC;

/*
 * Procedure: SaveReading
 * Parameters:
 *   oReading - the reading to store
 * Returns: .T. when the row was written
;
:PROCEDURE SaveReading;
	:PARAMETERS oReading;
	:DECLARE sSQL;
	sSQL := "INSERT INTO LabResults (SampleId, Analyte, ResultValue, SourceReading) VALUES (?, ?, ?, ?)";
	:RETURN RunSQL(sSQL,, {oReading:sampleId, oReading:analyte, oReading:value, oReading:readingId});
:ENDPROC;
-- format --
/*
 * Script: ResultImport
 * Description: Copies instrument readings for one run into the results table
 * Parameters:
 *   sRunId - the instrument run to import
 * Returns: an import summary object
;
:PARAMETERS sRunId;
:DEFAULT sRunId, "";
:DECLARE oSummary, oData, oDataset, aRows, nRow, oReading, bValid, oErr;

oSummary := CreateUdObject("Lab.ImportSummary", {sRunId});
:IF Empty(sRunId);
	oSummary:message := "A run identifier is required";
	:RETURN oSummary;
:ENDIF;

:TRY;
	oData := SQLExecute("
	    SELECT ReadingId, SampleId, Analyte, Value
	    FROM InstrumentReadings
	    WHERE RunId = ?sRunId?
	",,,,, "dataset");
	oDataset := SSLDataset{oData, .T.};
	aRows := oDataset:ToArray();

	nRow := 1;
	:WHILE nRow <= Len(aRows);
		oReading := DoProc("ToReading", {aRows[nRow]});
		bValid := ExecFunction("Lab.ReadingRules.Validate", {oReading});
		:IF bValid;
			DoProc("SaveReading", {oReading});
			oSummary:imported += 1;
		:ELSE;
			oSummary:rejected += 1;
		:ENDIF;
		nRow += 1;
	:ENDWHILE;
	oSummary:message := "Import finished";
:CATCH;
	oErr := GetLastSSLError();
	oSummary:message := "Import failed: " + oErr:Description;
:FINALLY;
	oSummary:finishedOn := Now();
:ENDTRY;

:RETURN oSummary;

/*
 * Procedure: ToReading
 * Parameters:
 *   aRow - one dataset row {ReadingId, SampleId, Analyte, Value}
 * Returns: an anonymous reading object
;
:PROCEDURE ToReading;
	:PARAMETERS aRow;
	:DECLARE oReading;
	oReading := CreateUdObject({{"readingId", aRow[1]}, {"sampleId", aRow[2]}});
	oReading:analyte := AllTrim(aRow[3]);
	oReading:value := Val(LimsString(aRow[4]));
	:RETURN oReading;
:ENDPROC;

/*
 * Procedure: SaveReading
 * Parameters:
 *   oReading - the reading to store
 * Returns: .T. when the row was written
;
:PROCEDURE SaveReading;
	:PARAMETERS oReading;
	:DECLARE sSQL;
	sSQL := "
	    INSERT INTO LabResults (
	        SampleId, Analyte, ResultValue, SourceReading
	    )
	    VALUES (
	        ?, ?, ?, ?
	    )
	";
	:RETURN RunSQL(sSQL,, {oReading:sampleId, oReading:analyte, oReading:value,
		oReading:readingId});
:ENDPROC;
