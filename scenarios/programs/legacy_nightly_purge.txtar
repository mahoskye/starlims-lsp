A legacy nightly purge job: everything at column 0, keywords in mixed
case, a :WHILE driven by a manual counter with crammed body lines, an
:ENDFOR where :NEXT belongs, logical operators missing their periods
(AND), zero-based array indexing (a literal [0] and a loop from 0), bare RunSQL string building by
concatenation, and an :ERROR / :RESUME pair. Formatting plus the full
diagnostic picture of an old maintenance script.
Also carries a :FOR typed without its colon (For k ...) and a :WHILE
missing its ';', as hand-edited legacy code does.
Suspected issue: the validator pairs :ENDFOR with its :FOR (no unclosed_block; the later :NEXT is unmatched_block_end), but the formatter does not treat :ENDFOR as a closer, so every following line, the :PROCEDURE included, is indented one level too deep until a :NEXT.
The second half adds an archive procedure that sends a SELECT through
RunSQL (runsql_non_dml), compares strings with '= ""', declares a
:PUBLIC counter, and crams a :FOR loop body onto its header line.
-- input.ssl --
:PARAMETERS days;
:DECLARE cutoff, tables, t, n, sql, ok, deleted, purged;
:IF empty(days); days := 30; :ENDIF;
cutoff := DateAdd(Today(), -days, "dd");
tables := {"LabAuditLog", "LabTempResults", "LabSessionLog"};
purged := {};
UsrMes("first table: " + tables[0]);
n := 1;
:While n <= Len(tables)
t := tables[n];
sql := "delete from " + t + " where CreatedOn < ?";
ok := RunSQL(sql, , {cutoff});
:If ok AND n > 0; AAdd(purged, t); :EndIf;
n := n + 1;
:EndWhile;

:For n := 0 :To Len(purged) - 1;
deleted := purged[n];
UsrMes("purged " + deleted);
:EndFor;

:IF len(purged) == len(tables);
:RETURN "all purged";
:ENDIF;

DoProc("ReportPartial", {purged});
:RETURN "partial";

:PROCEDURE ReportPartial;
:PARAMETERS done;
:DECLARE msg, k;
msg := "";
For k := 1 :TO Len(done); msg := msg + done[k] + " "; :NEXT;
ErrorMes("purge", "partial: " + msg);
:ERROR;
ErrorMes("purge", "ReportPartial failed");
:RESUME;
:ENDPROC;

:PROCEDURE Archive;
:PARAMETERS tbl, before;
:PUBLIC archived;
:DECLARE cnt, rows, j, ok;
:IF tbl = ""; :RETURN 0; :ENDIF;
cnt := RunSQL("select count(*) from LabArchiveQueue where TableName = ?", , {tbl});
rows := LSelect1("select RowKey from LabArchiveQueue where TableName = ? and QueuedOn < ?",, {tbl, before});
:FOR j := 1 :TO Len(rows); ok := RunSQL("delete from LabArchiveQueue where RowKey = ?",, {rows[j][1]}); :NEXT;
archived := Len(rows);
:RETURN archived;
:ENDPROC;

:PROCEDURE Vacuum;
:PARAMETERS tbls;
:DECLARE x, res;
res := "";
:FOR x := 1 :TO Len(tbls)
:IF tbls[x] == "LabAuditLog"; :LOOP; :ENDIF;
res := res + tbls[x] + ",";
:IF Len(res) > 200; :EXITFOR; :ENDIF;
:NEXT;
:RETURN Left(res, Len(res) - 1);
:ENDPROC;
