A legacy notification script: a built-in class created with call
parentheses (Email()) and through CreateUdObject("Email"), properties set
with dots, nested :IF blocks with no indentation at all, tabs and spaces
mixed, a :LABEL / Branch() retry loop, a code block built and evaluated,
and lowercase .t. / .and. / nil literals. Formatting and diagnostics
together on an old mail sender.
The second half adds a recipient-list helper with crammed lines, a
:BEGINCASE without :OTHERWISE or :EXITCASE, a :WHILE whose body mixes
tabs and spaces, and an :ERROR handler placed first so it protects
nothing (error_handler_structure).
Suspected issue: #326 — inside BuildList the formatter indents everything after the first-placed :ERROR as handler body, then ':ENDCASE' and ':ENDWHILE' each dedent one level too far (see edge-cases/error_handler_nested_block), contradicting fmt.indent_style's one level per enclosing block.
-- input.ssl --
:PARAMETERS recipients, subj, body;
:DECLARE mail, tries, sent, r, fmtfn, alt;
:DEFAULT subj, "LIMS notice";
tries := 0; sent := .f.;
fmtfn := {|x| "To: " + x};
:LABEL SendAgain;
tries := tries + 1;
mail := Email();
mail.Subject := subj;
mail:Body := body;
:for r := 1 :to len(recipients);
:if .not. empty(recipients[r]) .and. recipients[r] != nil;
mail:To := recipients[r];
:if tries > 1;
	UsrMes(eval(fmtfn, recipients[r]));
:endif;
:endif;
:next;
sent := mail:Send();
:if .not. sent .and. tries < 3;
    Branch("LABEL SendAgain");
:endif;
:if .not. sent;
	alt := CreateUdObject("Email");
	alt:To := "lims-admin@example.com";
		alt:Subject := "notify failed: " + subj;
  alt:Send();
:endif;
:return sent;

:procedure BuildList;
:parameters dept;
:declare lst, q, row, idx;
:error;
ErrorMes("BuildList", "lookup failed");
lst := {}; idx := 1;
q := LSelect1("select Email, Active from LabContacts where Dept = ?",, {dept});
:while idx <= len(q);
	row := q[idx];
        :begincase;
        :case row[2] = "Y";
	AAdd(lst, row[1]);
        :case row[2] = "";
  	UsrMes("no status for " + row[1]);
        :endcase;
    idx := idx + 1;
:endwhile;
:if len(lst) = 0; lst := {"lims-admin@example.com"}; :endif;
:return lst;
:endproc;

:procedure Retire;
:parameters addr;
:declare ok;
ok := RunSQL("update LabContacts set Active = 'N' where Email = '" + addr + "'");
:return ok;
:endproc;
-- format --
:PARAMETERS recipients, subj, body;
:DECLARE mail, tries, sent, r, fmtfn, alt;
:DEFAULT subj, "LIMS notice";
tries := 0;
sent := .F.;
fmtfn := {|x| "To: " + x};
:LABEL SendAgain;
tries := tries + 1;
mail := Email();
mail.Subject := subj;
mail:Body := body;
:FOR r := 1 :TO Len(recipients);
	:IF .NOT. Empty(recipients[r]) .AND. recipients[r] != NIL;
		mail:To := recipients[r];
		:IF tries > 1;
			UsrMes(Eval(fmtfn, recipients[r]));
		:ENDIF;
	:ENDIF;
:NEXT;
sent := mail:Send();
:IF .NOT. sent .AND. tries < 3;
	Branch("LABEL SendAgain");
:ENDIF;

:IF .NOT. sent;
	alt := CreateUdObject("Email");
	alt:To := "lims-admin@example.com";
	alt:Subject := "notify failed: " + subj;
	alt:Send();
:ENDIF;
:RETURN sent;

:PROCEDURE BuildList;
	:PARAMETERS dept;
	:DECLARE lst, q, row, idx;
	:ERROR;
		ErrorMes("BuildList", "lookup failed");
		lst := {};
		idx := 1;
		q := LSelect1("select Email, Active from LabContacts where Dept = ?",, {dept});
		:WHILE idx <= Len(q);
			row := q[idx];
			:BEGINCASE;
			:CASE row[2] = "Y";
				AAdd(lst, row[1]);
			:CASE row[2] = "";
				UsrMes("no status for " + row[1]);
		:ENDCASE;
		idx := idx + 1;
	:ENDWHILE;

	:IF Len(lst) = 0;
		lst := {"lims-admin@example.com"};
	:ENDIF;
	:RETURN lst;
:ENDPROC;

:PROCEDURE Retire;
	:PARAMETERS addr;
	:DECLARE ok;
	ok := RunSQL("update LabContacts set Active = 'N' where Email = '" + addr + "'");
	:RETURN ok;
:ENDPROC;
