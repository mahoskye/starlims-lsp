A UTF-8 byte-order mark before the first keyword. The BOM is not a
token: the first keyword must still be recognized at line 1 and the
formatter must keep the file otherwise unchanged.
-- input.ssl --
﻿:DECLARE nCount;
nCount := 1;
:if nCount > 0;
nCount += 1;
:endif;
:RETURN nCount;
-- format --
﻿:DECLARE nCount;

nCount := 1;

:IF nCount > 0;
	nCount += 1;
:ENDIF;

:RETURN nCount;
