Semicolons and comment markers inside string literals ("a;b", '/*x;',
[c;d]), and a comment with a second ';' inside its text: the first ';'
ends the comment and the rest of the line becomes code (AGENTS.md
comment rule). The formatter must keep string contents intact and must
treat the tail as code.
-- input.ssl --
:DECLARE sA, sB, sC;
sA := "a;b;c";
sB := '/*not a comment;';
sC := [SELECT * FROM T WHERE X = 'a;b'];
/* first part; second part looks like code;
:RETURN sA + sB + sC;
-- format --
:DECLARE sA, sB, sC;

sA := "a;b;c";
sB := '/*not a comment;';
sC := [SELECT * FROM T WHERE X = 'a;b'];

/* first part;
second part looks like code;

:RETURN sA + sB + sC;
