Numeric and literal edge forms: scientific notation with and without the
required decimal (7.0e2 vs 7e2), a leading-dot decimal, very large and
negative numbers, empty strings in all three quote styles, and NIL /
.T. / .F. in lowercase. Literal casing and spacing are what the
formatter may touch; digits and string contents must not change.
-- input.ssl --
:DECLARE nA, nB, nC, nD, sE, sF, sG, vH, bI;
nA := 7.0e2;
nB := 7e2;
nC := .5;
nD := -123456789012345678901234567890;
sE := "";
sF := '';
sG := [];
vH := nil;
bI := .t. .and. .f.;
:RETURN {nA, nB, nC, nD, sE, sF, sG, vH, bI};
-- format --
:DECLARE nA, nB, nC, nD, sE, sF, sG, vH, bI;

nA := 7.0e2;
nB := 7e2;
nC := .5;
nD := -123456789012345678901234567890;
sE := "";
sF := '';
sG := [];
vH := NIL;
bI := .T. .AND. .F.;

:RETURN {nA, nB, nC, nD, sE, sF, sG, vH, bI};
-- diagnostics --
3:7-3:8 error scientific_notation: SSL scientific notation requires a decimal point: use '7.0e2' instead of '7e2'
-- diagnostics [--strict --info] --
3:7-3:8 error scientific_notation: SSL scientific notation requires a decimal point: use '7.0e2' instead of '7e2'
