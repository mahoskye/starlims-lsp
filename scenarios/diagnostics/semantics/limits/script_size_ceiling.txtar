-- format --
/* Sends the weekly status summary by email;
:PARAMETERS sRecipient;
:DECLARE oEmail, sBody;

sBody := GetRegion("SummaryTemplate");
oEmail := Email{};
oEmail:Subject := "Weekly status summary";
oEmail:Body := sBody;
oEmail:AddRecipient(sRecipient);
:RETURN oEmail:Send();

:REGION SummaryTemplate;
