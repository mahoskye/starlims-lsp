Member access on something known to be NIL (diag.nil_method_call,
warning, ranged on the NIL expression): on the NIL literal itself, and
on a local whose most recent assignment was NIL. An :OR. guard does not
protect the use (only a top-level .AND. chain does).
-- input.ssl --
:PROCEDURE Teardown;
	:PARAMETERS bChanged;
	:DECLARE oConn, oPrev, sText;
	sText := NIL:ToString();
	oConn := CreateUdObject();
	oConn := NIL;
	oConn:Close();
	oPrev := NIL;
	:IF bChanged .OR. !Empty(oPrev);
		oPrev:Reset();
	:ENDIF;
	:RETURN sText;
:ENDPROC;
-- format --
:PROCEDURE Teardown;
	:PARAMETERS bChanged;
	:DECLARE oConn, oPrev, sText;

	sText := NIL:ToString();
	oConn := CreateUdObject();
	oConn := NIL;
	oConn:Close();
	oPrev := NIL;

	:IF bChanged .OR. !Empty(oPrev);
		oPrev:Reset();
	:ENDIF;

	:RETURN sText;
:ENDPROC;
-- diagnostics --
