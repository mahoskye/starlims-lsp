Near-misses for diag.nil_in_operations: a variable that holds NIL (no
data flow), comparisons against NIL, NIL assignment, a member chain on
NIL (nil_method_call's finding instead), and a compound assignment.
-- input.ssl --
:PROCEDURE Reset;
	:PARAMETERS nValue, dWhen;
	:DECLARE nOut, vHeld;
	vHeld := NIL;
	nOut := vHeld + 1;
	:IF nValue == NIL .OR. dWhen != NIL;
		nOut := 0;
	:ENDIF;
	:IF nValue = NIL;
		nOut := 1;
	:ENDIF;
	nOut += NIL;
	:RETURN nOut;
:ENDPROC;
-- format --
:PROCEDURE Reset;
	:PARAMETERS nValue, dWhen;
	:DECLARE nOut, vHeld;
	vHeld := NIL;
	nOut := vHeld + 1;
	:IF nValue == NIL .OR. dWhen != NIL;
		nOut := 0;
	:ENDIF;

	:IF nValue = NIL;
		nOut := 1;
	:ENDIF;
	nOut += NIL;
	:RETURN nOut;
:ENDPROC;
