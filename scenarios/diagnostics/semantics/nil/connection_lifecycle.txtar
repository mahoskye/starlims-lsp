A realistic open/use/close routine where NIL rules meet: a guarded
release (quiet), a use after the release (nil_method_call), a NIL
compared against "" (info), and a NIL in a string concatenation. The
:FINALLY body has statements and no :RETURN.
-- input.ssl --
:PROCEDURE SyncLabels;
	:PARAMETERS sHost;
	:DECLARE oConn, sLog, bOk;
	bOk := .F.;
	sLog := "";
	:TRY;
		oConn := LimsNetConnect("LabelBridge", "LabelBridge.Client");
		oConn:Open(sHost);
		bOk := oConn:Push();
	:CATCH;
		sLog := "sync failed: " + GetLastSSLError():Description;
	:FINALLY;
		:IF !Empty(oConn);
			oConn:Close();
			oConn := NIL;
		:ENDIF;
	:ENDTRY;
	:IF oConn == "";
		sLog := sLog + " (no connection)";
	:ENDIF;
	:IF NIL = "";
		sLog := sLog + NIL;
	:ENDIF;
	oConn := NIL;
	oConn:Dispose();
	:RETURN bOk;
:ENDPROC;
-- format --
:PROCEDURE SyncLabels;
	:PARAMETERS sHost;
	:DECLARE oConn, sLog, bOk;
	bOk := .F.;
	sLog := "";
	:TRY;
		oConn := LimsNETConnect("LabelBridge", "LabelBridge.Client");
		oConn:Open(sHost);
		bOk := oConn:Push();
	:CATCH;
		sLog := "sync failed: " + GetLastSSLError():Description;
	:FINALLY;
		:IF !Empty(oConn);
			oConn:Close();
			oConn := NIL;
		:ENDIF;
	:ENDTRY;

	:IF oConn == "";
		sLog := sLog + " (no connection)";
	:ENDIF;

	:IF NIL = "";
		sLog := sLog + NIL;
	:ENDIF;
	oConn := NIL;
	oConn:Dispose();
	:RETURN bOk;
:ENDPROC;
