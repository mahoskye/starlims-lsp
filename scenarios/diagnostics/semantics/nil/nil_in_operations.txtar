The literal NIL as an operand of +, -, * or / is always a runtime error
(diag.nil_in_operations, warning, on the operator), on either side, and
under a unary minus.
-- input.ssl --
:PROCEDURE Sum;
	:PARAMETERS nBase;
	:DECLARE nOut, sMsg;
	nOut := NIL + 1;
	nOut := nBase - NIL;
	nOut := NIL * nBase;
	nOut := nBase / NIL;
	sMsg := "Total: " + NIL;
	nOut := -NIL;
	:RETURN nOut;
:ENDPROC;
-- format --
:PROCEDURE Sum;
	:PARAMETERS nBase;
	:DECLARE nOut, sMsg;
	nOut := NIL + 1;
	nOut := nBase - NIL;
	nOut := NIL * nBase;
	nOut := nBase / NIL;
	sMsg := "Total: " + NIL;
	nOut := -NIL;
	:RETURN nOut;
:ENDPROC;
