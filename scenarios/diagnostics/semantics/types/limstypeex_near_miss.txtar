Near-misses for diag.invalid_limstypeex_comparison: valid result names,
= prefix matches that can be true either way round ("NUM", "STRINGS"),
a non-literal comparand, and LimsTypeEx used in IIF/concatenation. The
<> on the valid name is still not_preferred_operator's (info) finding.
-- input.ssl --
:PROCEDURE Classify;
	:PARAMETERS vValue, sExpected;
	:DECLARE bHit, sDesc;
	bHit := LimsTypeEx(vValue) == "NUMERIC";
	bHit := bHit .OR. LimsTypeEx(vValue) = "NUM";
	bHit := bHit .OR. "STRINGS" = LimsTypeEx(vValue);
	bHit := bHit .OR. LimsTypeEx(vValue) == sExpected;
	bHit := bHit .AND. LimsTypeEx(vValue) <> "CODEBLOCK";
	sDesc := "type " + LimsTypeEx(vValue);
	sDesc := IIF(bHit, LimsTypeEx(vValue), sDesc);
	:RETURN sDesc;
:ENDPROC;
-- format --
:PROCEDURE Classify;
	:PARAMETERS vValue, sExpected;
	:DECLARE bHit, sDesc;
	bHit := LimsTypeEx(vValue) == "NUMERIC";
	bHit := bHit .OR. LimsTypeEx(vValue) = "NUM";
	bHit := bHit .OR. "STRINGS" = LimsTypeEx(vValue);
	bHit := bHit .OR. LimsTypeEx(vValue) == sExpected;
	bHit := bHit .AND. LimsTypeEx(vValue) <> "CODEBLOCK";
	sDesc := "type " + LimsTypeEx(vValue);
	sDesc := IIf(bHit, LimsTypeEx(vValue), sDesc);
	:RETURN sDesc;
:ENDPROC;
-- diagnostics --
