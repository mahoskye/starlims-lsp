A literal zero :STEP never advances the loop (diag.step_zero_literal,
warning, on the literal): 0, 0.0, 00 and -0 all fire.
-- input.ssl --
:PROCEDURE Spin;
	:DECLARE i, nHits;
	nHits := 0;
	:FOR i := 1 :TO 10 :STEP 0;
		nHits := nHits + 1;
	:NEXT;
	:FOR i := 1 :TO 10 :STEP 0.0;
		nHits := nHits + 1;
	:NEXT;
	:FOR i := 1 :TO 10 :STEP 00;
		nHits := nHits + 1;
	:NEXT;
	:FOR i := 10 :TO 1 :STEP -0;
		nHits := nHits + 1;
	:NEXT;
	:RETURN nHits;
:ENDPROC;
-- format --
:PROCEDURE Spin;
	:DECLARE i, nHits;

	nHits := 0;

	:FOR i := 1 :TO 10 :STEP 0;
		nHits := nHits + 1;
	:NEXT;

	:FOR i := 1 :TO 10 :STEP 0.0;
		nHits := nHits + 1;
	:NEXT;

	:FOR i := 1 :TO 10 :STEP 00;
		nHits := nHits + 1;
	:NEXT;

	:FOR i := 10 :TO 1 :STEP -0;
		nHits := nHits + 1;
	:NEXT;

	:RETURN nHits;
:ENDPROC;
-- diagnostics --
