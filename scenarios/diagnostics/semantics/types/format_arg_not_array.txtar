String:Format on an s-prefixed template takes the template plus one
array (diag.format_arg_not_array, warning, on the second argument): a
scalar second argument of any expression shape fires, and more than two
arguments fire unconditionally. A composed receiver drops the name from
the message.
-- input.ssl --
:PROCEDURE Greet;
	:PARAMETERS sFirst, sLast, nCount;
	:DECLARE sFmt, sMsg;
	sFmt := "Hello {0} {1}";
	sMsg := sFmt:Format("{0}", sFirst);
	sMsg := sFmt:Format("{0} {1}", sFirst, sLast);
	sMsg := sFmt:Format("{0}", sFirst + sLast);
	sMsg := sFmt:Format("{0}", nCount > 3);
	sMsg := AllTrim(sFmt):Format("{0}", Len(sLast));
	:RETURN sMsg;
:ENDPROC;
-- format --
:PROCEDURE Greet;
	:PARAMETERS sFirst, sLast, nCount;
	:DECLARE sFmt, sMsg;

	sFmt := "Hello {0} {1}";
	sMsg := sFmt:Format("{0}", sFirst);
	sMsg := sFmt:Format("{0} {1}", sFirst, sLast);
	sMsg := sFmt:Format("{0}", sFirst + sLast);
	sMsg := sFmt:Format("{0}", nCount > 3);
	sMsg := AllTrim(sFmt):Format("{0}", Len(sLast));

	:RETURN sMsg;
:ENDPROC;
