A realistic totals routine where type rules meet: a string prefix
concatenated with a number, NIL in arithmetic, a string :FOR limit, a
literal-zero index, an array :Count, and a date offset written number
first. The date + number, string + string and LimsString() forms beside
them are correct and stay quiet.
-- input.ssl --
:PROCEDURE InvoiceTotals;
	:PARAMETERS aLines, dIssued, sCurrency;
	:DECLARE nSum, nIdx, sSummary, dDue, aTaxRates, nRate;
	nSum := 0;
	aTaxRates := {0.2, 0.1};
	:FOR nIdx := 1 :TO "12";
		nSum := nSum + aLines[nIdx];
	:NEXT;
	nRate := aTaxRates[0];
	nSum := nSum * (1 + nRate) + NIL;
	dDue := 30 + dIssued;
	dDue := dIssued + 30;
	sSummary := "Total " + nSum;
	sSummary := "Total " + LimsString(nSum) + " " + sCurrency;
	sSummary := sSummary + " (" + LimsString(aTaxRates:Count) + " rates)";
	:RETURN sSummary + " due " + DToC(dDue);
:ENDPROC;
-- format --
:PROCEDURE InvoiceTotals;
	:PARAMETERS aLines, dIssued, sCurrency;
	:DECLARE nSum, nIdx, sSummary, dDue, aTaxRates, nRate;

	nSum := 0;
	aTaxRates := {0.2, 0.1};

	:FOR nIdx := 1 :TO "12";
		nSum := nSum + aLines[nIdx];
	:NEXT;

	nRate := aTaxRates[0];
	nSum := nSum * (1 + nRate) + NIL;
	dDue := 30 + dIssued;
	dDue := dIssued + 30;
	sSummary := "Total " + nSum;
	sSummary := "Total " + LimsString(nSum) + " " + sCurrency;
	sSummary := sSummary + " (" + LimsString(aTaxRates:Count) + " rates)";

	:RETURN sSummary + " due " + DToC(dDue);
:ENDPROC;
