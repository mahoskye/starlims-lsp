Near-misses for diag.step_zero_literal: non-zero literal steps
(fractional, negative), a variable step that holds zero at run time, and
an expression that merely starts with a zero literal.
-- input.ssl --
:PROCEDURE Spin;
	:DECLARE i, nStep, nInc, nHits;
	nHits := 0;
	nStep := 0;
	nInc := 2;
	:FOR i := 1 :TO 10 :STEP 0.5;
		nHits := nHits + 1;
	:NEXT;
	:FOR i := 10 :TO 1 :STEP -1;
		nHits := nHits + 1;
	:NEXT;
	:FOR i := 1 :TO 10 :STEP nStep;
		nHits := nHits + 1;
	:NEXT;
	:FOR i := 1 :TO 10 :STEP 0 + nInc;
		nHits := nHits + 1;
	:NEXT;
	:RETURN nHits;
:ENDPROC;
-- format --
:PROCEDURE Spin;
	:DECLARE i, nStep, nInc, nHits;
	nHits := 0;
	nStep := 0;
	nInc := 2;
	:FOR i := 1 :TO 10 :STEP 0.5;
		nHits := nHits + 1;
	:NEXT;

	:FOR i := 10 :TO 1 :STEP -1;
		nHits := nHits + 1;
	:NEXT;

	:FOR i := 1 :TO 10 :STEP nStep;
		nHits := nHits + 1;
	:NEXT;

	:FOR i := 1 :TO 10 :STEP 0 + nInc;
		nHits := nHits + 1;
	:NEXT;
	:RETURN nHits;
:ENDPROC;
-- diagnostics --
-- diagnostics [--strict --info] --
