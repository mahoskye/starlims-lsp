Comparing code blocks raises before any comparison happens
(diag.code_block_comparison, warning, on the operator): ==, != and = with
an fn-prefixed operand or a code-block literal, and a comparison with
NIL.
-- input.ssl --
:PROCEDURE SameRule;
	:PARAMETERS fnLeft, fnRight;
	:DECLARE bSame;
	bSame := fnLeft == fnRight;
	bSame := fnLeft != fnRight;
	bSame := fnLeft == NIL;
	bSame := {|x| x + 1} = fnRight;
	:RETURN bSame;
:ENDPROC;
-- format --
:PROCEDURE SameRule;
	:PARAMETERS fnLeft, fnRight;
	:DECLARE bSame;

	bSame := fnLeft == fnRight;
	bSame := fnLeft != fnRight;
	bSame := fnLeft == NIL;
	bSame := {|x| x + 1} = fnRight;

	:RETURN bSame;
:ENDPROC;
-- diagnostics --
4:18-4:20 warning code_block_comparison: Code blocks (lambdas) cannot be compared with '=='. This causes an error
