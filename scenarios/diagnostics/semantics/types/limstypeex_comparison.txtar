LimsTypeEx returns one of nine uppercase names and string comparison is
case-sensitive (diag.invalid_limstypeex_comparison, error, on the
literal): == "NUMBER" is never true, <> "NUMBER" always true, = "String"
(wrong case, no result starts with it), and "INTEGER" = LimsTypeEx(...)
(literal on the left starts with no result).
-- input.ssl --
:PROCEDURE Classify;
	:PARAMETERS vValue;
	:IF LimsTypeEx(vValue) == "NUMBER";
		:RETURN 1;
	:ENDIF;
	:IF LimsTypeEx(vValue) = "String";
		:RETURN 2;
	:ENDIF;
	:IF "INTEGER" = LimsTypeEx(vValue);
		:RETURN 3;
	:ENDIF;
	:RETURN LimsTypeEx(vValue) <> "NUMBER";
:ENDPROC;
-- format --
:PROCEDURE Classify;
	:PARAMETERS vValue;

	:IF LimsTypeEx(vValue) == "NUMBER";
		:RETURN 1;
	:ENDIF;

	:IF LimsTypeEx(vValue) = "String";
		:RETURN 2;
	:ENDIF;

	:IF "INTEGER" = LimsTypeEx(vValue);
		:RETURN 3;
	:ENDIF;

	:RETURN LimsTypeEx(vValue) <> "NUMBER";
:ENDPROC;
