An unquoted dotted path as the first argument of ExecFunction or DoProc
(diag.execfunction_missing_quotes, error, from the identifier through the
dotted fragment). dot_property_access stays silent on that fragment
(issue #255): one finding per defect.
-- input.ssl --
:PROCEDURE Dispatch;
	:DECLARE nOut;
	nOut := ExecFunction(Billing.ComputeFees, {1});
	nOut := DoProc(Reports.BuildSummary, {nOut});
	nOut := execfunction(Billing.Tax.Rate);
	:RETURN nOut;
:ENDPROC;
-- format --
:PROCEDURE Dispatch;
	:DECLARE nOut;

	nOut := ExecFunction(Billing.ComputeFees, {1});
	nOut := DoProc(Reports.BuildSummary, {nOut});
	nOut := ExecFunction(Billing.Tax.Rate);

	:RETURN nOut;
:ENDPROC;
-- diagnostics --
3:23-3:42 error execfunction_missing_quotes: Namespace path must be quoted: ExecFunction("Module.Procedure", ...) not ExecFunction(Module.Procedure, ...)
4:17-4:37 error execfunction_missing_quotes: Namespace path must be quoted: DoProc("Module.Procedure", ...) not DoProc(Module.Procedure, ...)
5:23-5:39 error execfunction_missing_quotes: Namespace path must be quoted: execfunction("Module.Procedure", ...) not execfunction(Module.Procedure, ...)
-- diagnostics [--strict --info] --
3:23-3:42 error execfunction_missing_quotes: Namespace path must be quoted: ExecFunction("Module.Procedure", ...) not ExecFunction(Module.Procedure, ...)
4:17-4:37 error execfunction_missing_quotes: Namespace path must be quoted: DoProc("Module.Procedure", ...) not DoProc(Module.Procedure, ...)
5:23-5:39 error execfunction_missing_quotes: Namespace path must be quoted: execfunction("Module.Procedure", ...) not execfunction(Module.Procedure, ...)
