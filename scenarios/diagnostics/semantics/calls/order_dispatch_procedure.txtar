A realistic dispatcher written with habits from other languages: a
same-file procedure called directly (error tier), an unquoted
ExecFunction path, dot property access on a UDO, an empty trailing
argument array, a builtin with a surplus argument, and spaced skip
commas. The correct DoProc and colon forms in the same body stay quiet.
-- input.ssl --
:PROCEDURE PriceLine;
	:PARAMETERS nQty, nUnit;
	:RETURN nQty * nUnit;
:ENDPROC;
:PROCEDURE DispatchOrder;
	:PARAMETERS oOrder;
	:DECLARE nTotal, sCarrier, aLines, i;
	aLines := oOrder:lines;
	nTotal := 0;
	:FOR i := 1 :TO Len(aLines);
		nTotal += PriceLine(aLines[i][2], aLines[i][3]);
		nTotal += DoProc("PriceLine", {aLines[i][2], aLines[i][3]});
	:NEXT;
	sCarrier := ExecFunction(Shipping.PickCarrier, {nTotal});
	oOrder.carrier := sCarrier;
	oOrder:carrier := Upper(sCarrier, 1);
	DoProc("NotifyWarehouse", {});
	DoProc("LogEvent", {"dispatch", , oOrder:orderNo});
	:RETURN nTotal;
:ENDPROC;
-- format --
:PROCEDURE PriceLine;
	:PARAMETERS nQty, nUnit;

	:RETURN nQty * nUnit;
:ENDPROC;

:PROCEDURE DispatchOrder;
	:PARAMETERS oOrder;
	:DECLARE nTotal, sCarrier, aLines, i;

	aLines := oOrder:lines;
	nTotal := 0;

	:FOR i := 1 :TO Len(aLines);
		nTotal += PriceLine(aLines[i][2], aLines[i][3]);
		nTotal += DoProc("PriceLine", {aLines[i][2], aLines[i][3]});
	:NEXT;

	sCarrier := ExecFunction(Shipping.PickCarrier, {nTotal});
	oOrder.carrier := sCarrier;
	oOrder:carrier := Upper(sCarrier, 1);
	DoProc("NotifyWarehouse", {});
	DoProc("LogEvent", {"dispatch",, oOrder:orderNo});

	:RETURN nTotal;
:ENDPROC;
-- diagnostics --
11:13-11:22 error direct_procedure_call: Custom procedures cannot be called directly. Use DoProc("PriceLine", {args}) for same-file script procedures, ExecFunction(...) for external script procedures, or Me:/Base: inside classes.
14:27-14:47 error execfunction_missing_quotes: Namespace path must be quoted: ExecFunction("Module.Procedure", ...) not ExecFunction(Module.Procedure, ...)
15:8-15:16 error dot_property_access: SSL uses colon ':' for property access, not dot '.'. Use 'object:carrier' instead of 'object.carrier'
16:36-16:37 warning builtin_excess_arguments: 'Upper' accepts at most 1 argument(s) - the compiler silently drops the surplus 1 argument (never evaluated)
