:DECLARE accepts only a name list; each inline := initializer fires
diag.declare_initializer on its operator, one per initializer.
-- input.ssl --
:PROCEDURE SeedCounters;
	:DECLARE nOpened := 0;
	:DECLARE nClosed := 0, sLabel := "none", nSkipped;
	nSkipped := nOpened + nClosed;
	:RETURN sLabel;
:ENDPROC;
-- format --
:PROCEDURE SeedCounters;
	:DECLARE nOpened := 0;
	:DECLARE nClosed := 0, sLabel := "none", nSkipped;
	nSkipped := nOpened + nClosed;
	:RETURN sLabel;
:ENDPROC;
