A fractional array index raises at run time on STARLIMS 12, and `/`
always divides exactly, so an index computed with `/` is a fraction
whenever the division is uneven (diag.array_index_whole_number, error, on
the subscript). A literal quotient that is whole, an Integer()-wrapped
quotient and other arithmetic stay silent (issue #339).
-- input.ssl --
:PROCEDURE Middle;
	:PARAMETERS aRows;
	:DECLARE nCount, vItem;
	nCount := Len(aRows);
	vItem := aRows[nCount / 2];
	vItem := aRows[(nCount + 1) / 2];
	vItem := aRows[2.5];
	vItem := aRows[Integer(nCount / 2)];
	vItem := aRows[4 / 2];
	vItem := aRows[nCount - 1];
	:RETURN vItem;
:ENDPROC;
-- format --
:PROCEDURE Middle;
	:PARAMETERS aRows;
	:DECLARE nCount, vItem;

	nCount := Len(aRows);
	vItem := aRows[nCount / 2];
	vItem := aRows[(nCount + 1) / 2];
	vItem := aRows[2.5];
	vItem := aRows[Integer(nCount / 2)];
	vItem := aRows[4 / 2];
	vItem := aRows[nCount - 1];

	:RETURN vItem;
:ENDPROC;
-- diagnostics --
