A realistic routine mixing a .NET DataSet with native arrays: the
oData:Tables[0] chain never flags (issue #304); once the table is held in
oTable, oTable:Rows[...]:ItemArray[0] no longer passes through :Tables
textually, so it is the member-reached info tier; the native result
array read at [0] is an error, a .NET list read at [0] is info, and
:Count on an array built from {} raises. AAdd and Len are the native
forms.
-- input.ssl --
:PROCEDURE CollectNames;
	:PARAMETERS sXml;
	:DECLARE oData, oTable, aNames, oList, i, sFirst, nCount;
	oData := LimsNetConnect("System.Data", "System.Data.DataSet");
	oData:ReadXml(sXml);
	oTable := oData:Tables[0];
	aNames := {};
	:FOR i := 1 :TO oTable:Rows:Count;
		AAdd(aNames, oTable:Rows[i - 1]:ItemArray[0]);
	:NEXT;
	sFirst := aNames[0];
	oList := LimsNetConnect("mscorlib", "System.Collections.ArrayList");
	sFirst := oList:Items[0];
	nCount := aNames:Count;
	nCount := Len(aNames);
	:RETURN sFirst;
:ENDPROC;
-- format --
:PROCEDURE CollectNames;
	:PARAMETERS sXml;
	:DECLARE oData, oTable, aNames, oList, i, sFirst, nCount;
	oData := LimsNETConnect("System.Data", "System.Data.DataSet");
	oData:ReadXml(sXml);
	oTable := oData:Tables[0];
	aNames := {};
	:FOR i := 1 :TO oTable:Rows:Count;
		AAdd(aNames, oTable:Rows[i - 1]:ItemArray[0]);
	:NEXT;
	sFirst := aNames[0];
	oList := LimsNETConnect("mscorlib", "System.Collections.ArrayList");
	sFirst := oList:Items[0];
	nCount := aNames:Count;
	nCount := Len(aNames);
	:RETURN sFirst;
:ENDPROC;
