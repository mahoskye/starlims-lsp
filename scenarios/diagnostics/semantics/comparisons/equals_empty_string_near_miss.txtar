Near-misses for diag.equals_empty_string: Empty(), == "" and != "",
"" = x (true only when x is empty — a correct emptiness test), a
non-string left operand, a bare x = ""; statement (a mistyped
assignment, not a test), and "" inside SQL text.
-- input.ssl --
:PROCEDURE Blank;
	:PARAMETERS sStatus, nCount;
	:DECLARE bBlank, sSql;
	bBlank := Empty(sStatus);
	bBlank := sStatus == "" .OR. sStatus != "";
	bBlank := "" = sStatus;
	bBlank := nCount = "";
	sSql := "UPDATE lots SET note = '' WHERE id = ?";
	sStatus = "";
	:RETURN bBlank;
:ENDPROC;
-- format --
:PROCEDURE Blank;
	:PARAMETERS sStatus, nCount;
	:DECLARE bBlank, sSql;
	bBlank := Empty(sStatus);
	bBlank := sStatus == "" .OR. sStatus != "";
	bBlank := "" = sStatus;
	bBlank := nCount = "";
	sSql := "UPDATE lots SET note = '' WHERE id = ?";
	sStatus = "";
	:RETURN bBlank;
:ENDPROC;
