A realistic status filter where operator rules meet: a bare AND, a
prefix-matching = "" test, a <> comparison, a negated :IF with :ELSE, a
:= typed for = in a :WHILE, a nested IIF and a C-style &&. The dotted
operators, == and != beside them are correct.
-- input.ssl --
:PROCEDURE FilterStatus;
	:PARAMETERS aRows, sWanted, bStrict;
	:DECLARE aOut, i, sStatus, sTag, nLeft;
	aOut := {};
	:FOR i := 1 :TO Len(aRows);
		sStatus := aRows[i][2];
		:IF sStatus = "" AND bStrict;
			:LOOP;
		:ENDIF;
		:IF .NOT. bStrict;
			sTag := IIF(sStatus == sWanted, "hit", IIF(sStatus <> "", "miss", "blank"));
		:ELSE;
			sTag := IIF(sStatus != sWanted, "miss", "hit");
		:ENDIF;
		:IF sTag == "hit" && bStrict;
			AAdd(aOut, aRows[i]);
		:ENDIF;
	:NEXT;
	nLeft := Len(aOut);
	:WHILE nLeft := 0;
		nLeft := 1;
	:ENDWHILE;
	:RETURN aOut;
:ENDPROC;
-- format --
:PROCEDURE FilterStatus;
	:PARAMETERS aRows, sWanted, bStrict;
	:DECLARE aOut, i, sStatus, sTag, nLeft;
	aOut := {};
	:FOR i := 1 :TO Len(aRows);
		sStatus := aRows[i][2];
		:IF sStatus = "" AND bStrict;
			:LOOP;
		:ENDIF;

		:IF .NOT. bStrict;
			sTag := IIf(sStatus == sWanted, "hit", IIf(sStatus <> "", "miss", "blank"));
		:ELSE;
			sTag := IIf(sStatus != sWanted, "miss", "hit");
		:ENDIF;

		:IF sTag == "hit" && bStrict;
			AAdd(aOut, aRows[i]);
		:ENDIF;
	:NEXT;
	nLeft := Len(aOut);
	:WHILE nLeft := 0;
		nLeft := 1;
	:ENDWHILE;
	:RETURN aOut;
:ENDPROC;
