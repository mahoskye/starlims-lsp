Near-misses for diag.dollar_string_only: string with string, a member
read (its prefix says nothing about the runtime value, commit d134334),
a loop counter, an UPPER_SNAKE constant, and an array element.
-- input.ssl --
:PROCEDURE Lookup;
	:PARAMETERS ALLOWED_CODES, oRecord, aCodes, sHay;
	:DECLARE x, bHit;
	x := DoProc("NextCode");
	bHit := "A" $ ALLOWED_CODES .OR. "B" $ x;
	bHit := bHit .OR. oRecord:nCode $ sHay;
	bHit := bHit .OR. aCodes[1] $ sHay;
	bHit := bHit .OR. "C" $ sHay;
	:RETURN bHit;
:ENDPROC;
-- format --
:PROCEDURE Lookup;
	:PARAMETERS ALLOWED_CODES, oRecord, aCodes, sHay;
	:DECLARE x, bHit;

	x := DoProc("NextCode");
	bHit := "A" $ ALLOWED_CODES .OR. "B" $ x;
	bHit := bHit .OR. oRecord:nCode $ sHay;
	bHit := bHit .OR. aCodes[1] $ sHay;
	bHit := bHit .OR. "C" $ sHay;

	:RETURN bHit;
:ENDPROC;
