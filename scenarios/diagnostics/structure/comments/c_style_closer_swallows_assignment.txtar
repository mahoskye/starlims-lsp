A banner comment closed C-style, followed by an assignment. The
assignment is inside the comment and never runs; comment_swallows_code
(warning) reports it (diag.comment_swallows_code first Flags fence
shape).
-- input.ssl --
:PROCEDURE InitTotals;
	:DECLARE nGross, nNet;
	/* ---------------------------------
	   Initialize the running totals
	   --------------------------------- */
	nGross := 0;
	nNet := nGross;
	:RETURN nNet;
:ENDPROC;
-- format --
:PROCEDURE InitTotals;
	:DECLARE nGross, nNet;
	/* ---------------------------------
	   Initialize the running totals
	   --------------------------------- */
	nGross := 0;
	nNet := nGross;
	:RETURN nNet;
:ENDPROC;
-- diagnostics --
3:2-6:14 warning comment_swallows_code: This comment does not end at its '*/' - SSL comments end at ';', so it runs on and swallows 'nGross := 0'. That code never executes. End the comment with ';'
-- diagnostics [--strict --info] --
