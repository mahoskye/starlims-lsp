Code following a comment's `;` on the same line is valid SSL when it
parses, so diag.comment_text_after_terminator does not report it (issue
#343 dropped the same-line path; the formatter moves the statement to its
own line, fmt.indent_style issue #101).
-- input.ssl --
:PROCEDURE ResetFlags;
	:DECLARE bDirty, bLocked;
	/* clear both flags; bDirty := .F.;
	bLocked := .F.;
	:RETURN bLocked;
:ENDPROC;
-- format --
:PROCEDURE ResetFlags;
	:DECLARE bDirty, bLocked;

	/* clear both flags;
	bDirty := .F.;
	bLocked := .F.;

	:RETURN bLocked;
:ENDPROC;
-- diagnostics --
-- diagnostics [--strict --info] --
