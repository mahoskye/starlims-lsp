Near miss for mixed_error_handling_families: the two families in
different procedures of the same file, plus `LimsString(:ERROR)` in
expression position inside a :CATCH (only the marker statement `:ERROR;`
starts a legacy handler). Only deprecated_keyword fires
(diag.mixed_error_handling_families "must NOT flag").
`LimsString(:ERROR)` is not SSL — the grammar has only the `:ERROR;` statement marker —
so unexpected_token reports it, and the formatter does not treat it as a handler (issue #328).
-- input.ssl --
:PROCEDURE LegacyLoad;
	:DECLARE nLoaded;
	nLoaded := LSearch("SELECT COUNT(*) FROM STAGING", 0);
	:RETURN nLoaded;
	:ERROR;
	nLoaded := -1;
	:RESUME;
:ENDPROC;

:PROCEDURE ModernLoad;
	:DECLARE nLoaded, sResult;
	:TRY;
		nLoaded := LSearch("SELECT COUNT(*) FROM STAGING", 0);
	:CATCH;
		sResult := "Error: " + LimsString(:ERROR);
		ErrorMes("ModernLoad", sResult);
	:ENDTRY;
	:RETURN nLoaded;
:ENDPROC;
-- format --
:PROCEDURE LegacyLoad;
	:DECLARE nLoaded;
	nLoaded := LSearch("SELECT COUNT(*) FROM STAGING", 0);
	:RETURN nLoaded;
	:ERROR;
		nLoaded := -1;
	:RESUME;
:ENDPROC;

:PROCEDURE ModernLoad;
	:DECLARE nLoaded, sResult;
	:TRY;
		nLoaded := LSearch("SELECT COUNT(*) FROM STAGING", 0);
	:CATCH;
		sResult := "Error: " + LimsString(:ERROR);
		ErrorMes("ModernLoad", sResult);
	:ENDTRY;
	:RETURN nLoaded;
:ENDPROC;
-- diagnostics --
