An :ERROR handler whose body is empty before :RESUME, and a second
procedure whose :ERROR is the last thing before :ENDPROC. Both are the
empty-handler finding of error_handler_structure (error), plus
deprecated_keyword on each legacy keyword (diag.error_handler_structure).
-- input.ssl --
:PROCEDURE ReadQuota;
	:DECLARE nQuota;
	nQuota := LSearch("SELECT QUOTA FROM LIMITS", 0);
	:RETURN nQuota;
	:ERROR;
	:RESUME;
:ENDPROC;

:PROCEDURE ReadLimit;
	:DECLARE nLimit;
	nLimit := LSearch("SELECT MAXVAL FROM LIMITS", 0);
	:ERROR;
:ENDPROC;
-- format --
:PROCEDURE ReadQuota;
	:DECLARE nQuota;
	nQuota := LSearch("SELECT QUOTA FROM LIMITS", 0);
	:RETURN nQuota;
	:ERROR;
	:RESUME;
:ENDPROC;

:PROCEDURE ReadLimit;
	:DECLARE nLimit;
	nLimit := LSearch("SELECT MAXVAL FROM LIMITS", 0);
	:ERROR;
:ENDPROC;
