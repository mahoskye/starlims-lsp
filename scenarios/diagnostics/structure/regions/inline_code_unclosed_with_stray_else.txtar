An inline-code unit missing its :ENDINLINECODE, with an :ELSE inside it
whose :IF was opened outside the unit. The owning-block search stops at
:BEGININLINECODE, so the :ELSE is stray; the unit and the outer :IF are
both unclosed at end of file (diag.stray_block_keyword,
diag.unclosed_block).
-- input.ssl --
:DECLARE bVerbose;
bVerbose := .T.;
:IF bVerbose;
:BEGININLINECODE Banner;
:DECLARE sLine;
sLine := "verbose";
:ELSE;
sLine := "quiet";
-- format --
:DECLARE bVerbose;

bVerbose := .T.;

:IF bVerbose;
	:BEGININLINECODE Banner;
		:DECLARE sLine;

		sLine := "verbose";
	:ELSE;
		sLine := "quiet";
-- diagnostics --
3:1-3:4 error unclosed_block: Unclosed ':IF' - expected ':ENDIF'
4:1-4:17 error unclosed_block: Unclosed ':BEGININLINECODE' - expected ':ENDINLINECODE'
7:1-7:6 error stray_block_keyword: ':ELSE' is outside any ':IF' block
-- diagnostics [--strict --info] --
3:1-3:4 error unclosed_block: Unclosed ':IF' - expected ':ENDIF'
4:1-4:17 error unclosed_block: Unclosed ':BEGININLINECODE' - expected ':ENDINLINECODE'
7:1-7:6 error stray_block_keyword: ':ELSE' is outside any ':IF' block
