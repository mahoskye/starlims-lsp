A `:FOR EACH ... IN` header ported from another language. SSL has no
:FOR EACH form; unexpected_token flags the first departure from
`:FOR <id> := <expr> :TO <expr>` and the message says so. The :FOR block
still opens and pairs with :NEXT (diag.unexpected_token :FOR header).
-- input.ssl --
:PROCEDURE TotalItems;
	:PARAMETERS aItems;
	:DECLARE nTotal, nItem;
	nTotal := 0;
	:FOR EACH nItem IN aItems;
		nTotal += nItem;
	:NEXT;
	:RETURN nTotal;
:ENDPROC;
-- format --
:PROCEDURE TotalItems;
	:PARAMETERS aItems;
	:DECLARE nTotal, nItem;

	nTotal := 0;

	:FOR EACH nItem IN aItems;
		nTotal += nItem;
	:NEXT;

	:RETURN nTotal;
:ENDPROC;
-- diagnostics --
5:12-5:17 error unexpected_token: Unexpected identifier 'nItem' in ':FOR' header - expected ':=' (SSL has no ':FOR EACH' form)
-- diagnostics [--strict --info] --
5:12-5:17 error unexpected_token: Unexpected identifier 'nItem' in ':FOR' header - expected ':=' (SSL has no ':FOR EACH' form)
