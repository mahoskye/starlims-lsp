A :FOR header whose numeric limit runs straight into :STEP (`10:STEP 2`).
:STEP still lexes as the keyword and step_spacing (warning) fires on it
with the corrected form (diag.step_spacing).
-- input.ssl --
:PROCEDURE EvenTotal;
	:DECLARE nIdx, nTotal;
	nTotal := 0;
	:FOR nIdx := 2 :TO 10:STEP 2;
		nTotal := nTotal + nIdx;
	:NEXT;
	:RETURN nTotal;
:ENDPROC;
-- format --
:PROCEDURE EvenTotal;
	:DECLARE nIdx, nTotal;

	nTotal := 0;

	:FOR nIdx := 2 :TO 10 :STEP 2;
		nTotal := nTotal + nIdx;
	:NEXT;

	:RETURN nTotal;
:ENDPROC;
-- diagnostics --
4:23-4:28 warning step_spacing: ':STEP' should have a space before it: ':FOR i := 1 :TO 10 :STEP 2;'
-- diagnostics [--strict --info] --
4:23-4:28 warning step_spacing: ':STEP' should have a space before it: ':FOR i := 1 :TO 10 :STEP 2;'
