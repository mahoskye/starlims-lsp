`--no-sql` disables the embedded-SQL hand-off: the SQL string argument of
SQLExecute and RunSQL passes through byte-for-byte while the SSL around
it is still formatted (feature.formatting A5). The default variant is
recorded for contrast; the SQL layout itself is fmt.sql_in_strings'
business and is covered by the sql/ scenarios.
-- input.ssl --
:procedure LoadSamples;
:parameters sStatus;
:declare aRows,bOk;
aRows:=SQLExecute("select sampleid, status from samples where status = ?sStatus? order by sampleid");
bOk:=RunSQL("update samples set flag = 'Y' where status = ?",,{sStatus});
:return aRows;
:endproc;
-- format [--no-sql] --
:PROCEDURE LoadSamples;
	:PARAMETERS sStatus;
	:DECLARE aRows, bOk;

	aRows := SQLExecute("select sampleid, status from samples where status = ?sStatus? order by sampleid");
	bOk := RunSQL("update samples set flag = 'Y' where status = ?",, {sStatus});

	:RETURN aRows;
:ENDPROC;
-- format --
:PROCEDURE LoadSamples;
	:PARAMETERS sStatus;
	:DECLARE aRows, bOk;

	aRows := SQLExecute("
	    SELECT sampleid, status
	    FROM samples
	    WHERE status = ?sStatus?
	    ORDER BY sampleid
	");
	bOk := RunSQL("update samples set flag = 'Y' where status = ?",, {sStatus});

	:RETURN aRows;
:ENDPROC;
-- diagnostics --
1:1-1:11 error keyword_uppercase: SSL keywords are case-sensitive and must be uppercase: use ':PROCEDURE'
2:1-2:12 error keyword_uppercase: SSL keywords are case-sensitive and must be uppercase: use ':PARAMETERS'
3:1-3:9 error keyword_uppercase: SSL keywords are case-sensitive and must be uppercase: use ':DECLARE'
6:1-6:8 error keyword_uppercase: SSL keywords are case-sensitive and must be uppercase: use ':RETURN'
7:1-7:9 error keyword_uppercase: SSL keywords are case-sensitive and must be uppercase: use ':ENDPROC'
