Breaking before a binary operator: the operator leads its continuation
line (fmt.max_line_length; style guide ssl_max_line_length Good example).
-- input.ssl --
:PROCEDURE Describe;
:PARAMETERS sName, sStatus;
:DECLARE sOut;
sOut := sName + " is a fairly long string literal that " + sStatus + " keeps going past the limit";
:RETURN sOut;
:ENDPROC;
-- format --
:PROCEDURE Describe;
	:PARAMETERS sName, sStatus;
	:DECLARE sOut;

	sOut := sName + " is a fairly long string literal that " + sStatus
		+ " keeps going past the limit";

	:RETURN sOut;
:ENDPROC;
-- diagnostics --
-- diagnostics [--strict --info] --
