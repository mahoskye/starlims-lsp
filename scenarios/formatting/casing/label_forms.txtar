Labels: `:LABEL Name;` with a space is a keyword plus operand and is
uppercased like any keyword; a joined `:LABELName;` is written verbatim,
never split into `:LABEL Name;` (the two store different label text and
Branch() matches exactly), and a miscased joined form is not recased
either (fmt.keyword_case, issue #304).
-- input.ssl --
:PROCEDURE Retry;
:DECLARE nTries;
nTries := 0;
:label RetryPoint;
:LABELRETRY;
:labelSecondTry;
nTries += 1;
:IF nTries < 3;
Branch("LABELRETRY");
:ENDIF;
:RETURN nTries;
:ENDPROC;
-- format --
:PROCEDURE Retry;
	:DECLARE nTries;
	nTries := 0;
	:LABEL RetryPoint;
	:LABELRETRY;
	:labelSecondTry;
	nTries += 1;
	:IF nTries < 3;
		Branch("LABELRETRY");
	:ENDIF;
	:RETURN nTries;
:ENDPROC;
-- diagnostics --
