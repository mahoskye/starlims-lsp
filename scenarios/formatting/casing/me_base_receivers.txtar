`me` / `base` in member-access receiver position canonicalize to `Me` /
`Base`; an ordinary variable that only shares the name (`me := 1;`, `me +
1`) is never recased (fmt.keyword_case receiver-position gating).
-- input.ssl --
:CLASS SampleHandler;
:INHERIT Common.BaseHandler;
:DECLARE status;
:PROCEDURE Refresh;
:DECLARE nTotal;
me:status := "R";
nTotal := base:Compute(1) + ME:Count();
BASE:Refresh();
:RETURN nTotal;
:ENDPROC;
:PROCEDURE Shadow;
:DECLARE me;
me := 1;
:RETURN me + 1;
:ENDPROC;
-- format --
:CLASS SampleHandler;
:INHERIT Common.BaseHandler;
:DECLARE status;

:PROCEDURE Refresh;
	:DECLARE nTotal;
	Me:status := "R";
	nTotal := Base:Compute(1) + Me:Count();
	Base:Refresh();
	:RETURN nTotal;
:ENDPROC;

:PROCEDURE Shadow;
	:DECLARE me;
	me := 1;
	:RETURN me + 1;
:ENDPROC;
-- diagnostics --
-- diagnostics [--strict --info] --
