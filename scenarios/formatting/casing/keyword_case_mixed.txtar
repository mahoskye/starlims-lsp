Colon keywords in any mix of case become uppercase, including :TO,
:STEP, :EXITCASE, :ENDCASE and :DEFAULT; the casing surface needs no
option (fmt.keyword_case, keywords.case: upper). Legacy CamelCase and
lowercase keywords mixed in one procedure.
-- input.ssl --
:Procedure MixedCase;
:Parameters nLimit, sMode;
:Default nLimit, 10;
:Declare i, nSum;
nSum := 0;
:For i := 1 :to nLimit :Step 2;
:BeginCase;
:Case sMode == "ADD";
nSum += i;
:ExitCase;
:otherWise;
nSum -= i;
:exitcase;
:EndCase;
:Next;
:Return nSum;
:EndProc;
-- format --
:PROCEDURE MixedCase;
	:PARAMETERS nLimit, sMode;
	:DEFAULT nLimit, 10;
	:DECLARE i, nSum;

	nSum := 0;

	:FOR i := 1 :TO nLimit :STEP 2;
		:BEGINCASE;
		:CASE sMode == "ADD";
			nSum += i;
			:EXITCASE;
		:OTHERWISE;
			nSum -= i;
			:EXITCASE;
		:ENDCASE;
	:NEXT;

	:RETURN nSum;
:ENDPROC;
-- diagnostics --
