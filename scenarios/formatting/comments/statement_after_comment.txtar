A statement written on the same line after a standalone comment moves to
its own line, so code cannot hide behind a comment (fmt.indent_style
issue #101); the statement takes the block indent like any other.
-- input.ssl --
:PROCEDURE Demo;
:DECLARE nValue;
/* initialize; nValue := 1;
:IF nValue > 0;
/* bump it;nValue += 1;
:ENDIF;
:RETURN nValue;
:ENDPROC;
-- format --
:PROCEDURE Demo;
	:DECLARE nValue;

	/* initialize;
	nValue := 1;

	:IF nValue > 0;
		/* bump it;
		nValue += 1;
	:ENDIF;

	:RETURN nValue;
:ENDPROC;
-- diagnostics --
-- diagnostics [--strict --info] --
