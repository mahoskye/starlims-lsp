Standalone single-line comments take the enclosing block depth like
statements, whatever column the source left them at (fmt.indent_style
issue #36), including a comment directly before a middle keyword
(:ELSE) and one before :ENDPROC.
-- input.ssl --
:PROCEDURE Demo;
/* explains the setup;
:DECLARE nValue;
                        /* far right comment;
nValue := 1;
:IF nValue > 0;
/* positive branch;
nValue += 1;
/* about to switch to the other branch;
:ELSE;
nValue := 0;
:ENDIF;
/* end of procedure;
:ENDPROC;
-- format --
:PROCEDURE Demo;
	/* explains the setup;
	:DECLARE nValue;

	/* far right comment;
	nValue := 1;

	:IF nValue > 0;
		/* positive branch;
		nValue += 1;

		/* about to switch to the other branch;
	:ELSE;
		nValue := 0;
	:ENDIF;

	/* end of procedure;
:ENDPROC;
-- diagnostics --
-- diagnostics [--strict --info] --
