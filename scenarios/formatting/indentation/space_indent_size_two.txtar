--indent-style space with --indent-size 2: each block level is two spaces,
and a continuation line sits one level (two spaces) past its statement
line (fmt.indent_style, feature.formatting A8). The default tab variant
is recorded alongside for contrast.
-- input.ssl --
:PROCEDURE Tally;
:PARAMETERS aRows;
:DECLARE nTotal, i;
nTotal := 0;
:FOR i := 1 :TO Len(aRows);
:IF aRows[i] > 0;
nTotal := nTotal +
aRows[i];
:ENDIF;
:NEXT;
:RETURN nTotal;
:ENDPROC;
-- format [--indent-style space --indent-size 2] --
:PROCEDURE Tally;
  :PARAMETERS aRows;
  :DECLARE nTotal, i;
  nTotal := 0;
  :FOR i := 1 :TO Len(aRows);
    :IF aRows[i] > 0;
      nTotal := nTotal +
        aRows[i];
    :ENDIF;
  :NEXT;
  :RETURN nTotal;
:ENDPROC;
-- format --
:PROCEDURE Tally;
	:PARAMETERS aRows;
	:DECLARE nTotal, i;
	nTotal := 0;
	:FOR i := 1 :TO Len(aRows);
		:IF aRows[i] > 0;
			nTotal := nTotal +
				aRows[i];
		:ENDIF;
	:NEXT;
	:RETURN nTotal;
:ENDPROC;
-- diagnostics --
-- diagnostics [--strict --info] --
