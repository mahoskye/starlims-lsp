A :CLASS file: no :ENDCLASS, the class extends to end of file. :CLASS and
:INHERIT stay at column 0, class-level :DECLARE stays at column 0, and
each :PROCEDURE method indents its body (fmt.indent_style). Me/Base
receivers canonicalize (fmt.keyword_case) and procedures are separated by
one blank line (fmt.blank_lines_between_procs).
-- input.ssl --
:class OrderHandler;
:inherit Common.BaseHandler;
:declare orderNo, isValid;
:procedure Init;
:parameters sOrderNo;
me:orderNo := sOrderNo;
me:isValid := .f.;
base:Init();
:endproc;
:procedure Validate;
:if Empty(me:orderNo);
:return .f.;
:endif;
me:isValid := .t.;
:return me:isValid;
:endproc;
-- format --
:CLASS OrderHandler;
:INHERIT Common.BaseHandler;
:DECLARE orderNo, isValid;

:PROCEDURE Init;
	:PARAMETERS sOrderNo;

	Me:orderNo := sOrderNo;
	Me:isValid := .F.;
	Base:Init();
:ENDPROC;

:PROCEDURE Validate;
	:IF Empty(Me:orderNo);
		:RETURN .F.;
	:ENDIF;

	Me:isValid := .T.;

	:RETURN Me:isValid;
:ENDPROC;
