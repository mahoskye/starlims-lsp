Every block opener indents its body one level, middle keywords dedent
themselves, and keyword casing is normalized (fmt.indent_style,
fmt.keyword_case).
-- input.ssl --
:procedure Demo;
:parameters nValue;
:declare sLabel, i;
:if nValue > 0;
:for i := 1 :to nValue;
:begincase;
:case i == 1;
sLabel := "one";
:exitcase;
:otherwise;
sLabel := "many";
:exitcase;
:endcase;
:next;
:else;
sLabel := "none";
:endif;
:return sLabel;
:endproc;
-- format [--indent-style space] --
:PROCEDURE Demo;
    :PARAMETERS nValue;
    :DECLARE sLabel, i;

    :IF nValue > 0;
        :FOR i := 1 :TO nValue;
            :BEGINCASE;
            :CASE i == 1;
                sLabel := "one";
                :EXITCASE;
            :OTHERWISE;
                sLabel := "many";
                :EXITCASE;
            :ENDCASE;
        :NEXT;
    :ELSE;
        sLabel := "none";
    :ENDIF;

    :RETURN sLabel;
:ENDPROC;
-- format --
:PROCEDURE Demo;
	:PARAMETERS nValue;
	:DECLARE sLabel, i;

	:IF nValue > 0;
		:FOR i := 1 :TO nValue;
			:BEGINCASE;
			:CASE i == 1;
				sLabel := "one";
				:EXITCASE;
			:OTHERWISE;
				sLabel := "many";
				:EXITCASE;
			:ENDCASE;
		:NEXT;
	:ELSE;
		sLabel := "none";
	:ENDIF;

	:RETURN sLabel;
:ENDPROC;
