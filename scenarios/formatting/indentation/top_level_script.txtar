A script with top-level code (no :PROCEDURE): script-level :PARAMETERS
and :DEFAULT, top-level blocks and a trailing procedure. Top-level code
sits at column 0 and blocks indent from there (fmt.indent_style).
A blank line separates the top-level code from the trailing :PROCEDURE
(fmt.blank_lines_between_procs, schema blank_lines.before_procedure).
-- input.ssl --
:PARAMETERS sSampleId, nMode;
:DEFAULT nMode, 1;
:DECLARE vResult;
  :IF nMode == 1;
vResult := DoProc("LoadOne", {sSampleId});
    :ELSE;
vResult := "";
  :ENDIF;
:RETURN vResult;
:PROCEDURE LoadOne;
:PARAMETERS sId;
:RETURN sId;
:ENDPROC;
-- format --
:PARAMETERS sSampleId, nMode;
:DEFAULT nMode, 1;
:DECLARE vResult;

:IF nMode == 1;
	vResult := DoProc("LoadOne", {sSampleId});
:ELSE;
	vResult := "";
:ENDIF;

:RETURN vResult;

:PROCEDURE LoadOne;
	:PARAMETERS sId;

	:RETURN sId;
:ENDPROC;
-- diagnostics --
-- diagnostics [--strict --info] --
