A top-level script written as crammed one-liners: several statements and
whole :IF blocks on one line, missing semicolons at line ends, and a
:FOR loop on one line. Records how the formatter splits and indents
them (style guide one_statement_per_line, fmt.semicolon_enforcement,
fmt.indent_style).
-- input.ssl --
:parameters sMode;:default sMode,"FULL";:declare aRows,i,nCount
nCount:=0;aRows:={"a","b","c"}
:if sMode=="FULL";nCount:=Len(aRows);:else;nCount:=1;:endif
:for i:=1 :to nCount;DoProc("Touch",{aRows[i]});:next
:return nCount
-- format --
:PARAMETERS sMode;
:DEFAULT sMode, "FULL";
:DECLARE aRows, i, nCount;
nCount := 0;
aRows := {"a", "b", "c"};
:IF sMode == "FULL";
	nCount := Len(aRows);
:ELSE;
	nCount := 1;
:ENDIF;

:FOR i := 1 :TO nCount;
	DoProc("Touch", {aRows[i]});
:NEXT;
:RETURN nCount;
