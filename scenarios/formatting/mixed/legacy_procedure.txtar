A legacy-style procedure with everything wrong at once: lowercase and
CamelCase keywords, lowercase built-ins and dot operators, crammed
operators and commas, stray spaces before commas and semicolons, random
indentation, an end-of-line comment glued to code, a statement after a
standalone comment, and sibling blocks butted together. Exercises the
token formatter and every post-pass in one file (feature.formatting).
-- input.ssl --
:procedure UpdateSampleStatus;
:parameters sSampleId,sNewStatus ,bForce;
:default bForce,.f.;
   :declare sOldStatus,nRows,bOk,oErr;
bOk:=.f.;
sOldStatus:=lsearch("SELECT status FROM samples WHERE sampleid = ?","",,{sSampleId});/*current status;
      :if empty(sOldStatus).and..not.bForce;
  :return .f.;
:endif;
:if sOldStatus==sNewStatus;
:return .t.;
    :EndIf;
/* do the update; :try;
bOk:=runsql("UPDATE samples SET status = ? WHERE sampleid = ?",,{sNewStatus,sSampleId});
:catch;
oErr:=getlastsslerror();
errormes("UpdateSampleStatus","update failed: "+oErr:Description);
bOk:=.f.;
:endtry;
:return bOk;
:endproc;
-- format --
:PROCEDURE UpdateSampleStatus;
	:PARAMETERS sSampleId, sNewStatus, bForce;
	:DEFAULT bForce, .F.;
	:DECLARE sOldStatus, nRows, bOk, oErr;
	bOk := .F.;
	sOldStatus := LSearch("SELECT status FROM samples WHERE sampleid = ?", "",,
	                      {sSampleId});  /*current status;
	:IF Empty(sOldStatus) .AND. .NOT. bForce;
		:RETURN .F.;
	:ENDIF;

	:IF sOldStatus == sNewStatus;
		:RETURN .T.;
	:ENDIF;
	/* do the update;
	:TRY;
		bOk := RunSQL("UPDATE samples SET status = ? WHERE sampleid = ?",, {sNewStatus,
			sSampleId});
	:CATCH;
		oErr := GetLastSSLError();
		ErrorMes("UpdateSampleStatus", "update failed: " + oErr:Description);
		bOk := .F.;
	:ENDTRY;
	:RETURN bOk;
:ENDPROC;
