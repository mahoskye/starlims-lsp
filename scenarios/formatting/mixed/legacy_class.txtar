A small class file written in legacy style: lowercase keywords, `me:` /
`base:` receivers, a code block with lowercase built-ins, skipped
arguments with spaces, and methods butted together. Exercises class
indentation, receiver casing, code-block normalization and procedure
separation together (fmt.indent_style, fmt.keyword_case,
fmt.code_block_literals, fmt.comma_spacing, fmt.blank_lines_between_procs).
-- input.ssl --
:class ResultBatch;
:inherit Common.BatchBase;
:declare items,count;
:procedure Init;
:parameters aItems;
me:items:=aItems;
me:count:=alen(aItems);
base:Init();
:endproc;
:procedure Total;
:declare nSum,fnAdd;
nSum:=0;
fnAdd:={|n|nSum+=val(n)};
aeval(me:items,fnAdd);
:return nSum;
:endproc;
:procedure Find;
:parameters sValue;
:return ascan(me:items , sValue , , );
:endproc;
-- format --
:CLASS ResultBatch;
:INHERIT Common.BatchBase;
:DECLARE items, count;

:PROCEDURE Init;
	:PARAMETERS aItems;

	Me:items := aItems;
	Me:count := ALen(aItems);
	Base:Init();
:ENDPROC;

:PROCEDURE Total;
	:DECLARE nSum, fnAdd;

	nSum := 0;
	fnAdd := {|n| nSum += Val(n)};
	AEval(Me:items, fnAdd);

	:RETURN nSum;
:ENDPROC;

:PROCEDURE Find;
	:PARAMETERS sValue;

	:RETURN AScan(Me:items, sValue,,);
:ENDPROC;
