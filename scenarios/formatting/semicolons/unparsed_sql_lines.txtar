Raw SQL written outside any string in a server script (issue #351,
found by the VS Code extension's corpus harness). The lines do not parse
as SSL, and no split at their line ends makes them parse, so semicolon
enforcement leaves them alone: no `;` is added and the lines keep their
source spacing and indentation (`WIDGET_TEMP (NAME, SIZE)` and
`in ('A','B')` are not respaced as calls). The run stays one
unexpected_token, as in the input; terminating each line made it five.
-- input.ssl --
:PARAMETERS sIds := "1,2";

delete from WIDGET_TEMP

insert Into WIDGET_TEMP (NAME, SIZE)
   select WIDGETS.NAME, SIZE
   from   WIDGETS, BINS
   where  WIDGETS.BIN = BINS.BIN and BINS.STATE in ('A','B')
-- format --
:PARAMETERS sIds := "1,2";

delete from WIDGET_TEMP

insert Into WIDGET_TEMP (NAME, SIZE)
   select WIDGETS.NAME, SIZE
   from   WIDGETS, BINS
   where  WIDGETS.BIN = BINS.BIN and BINS.STATE in ('A','B')
