Lines that finish a statement without `;` get one when the next line
starts a new statement: after an identifier, number, string, closing
delimiter, postfix `++` (issue #99), a code-block literal and a keyword
(fmt.semicolon_enforcement); the :DECLARE line is terminated so the
diagnostics stay readable. `:BEGINCASE` always ends with `;`. Every
statement before a middle keyword (:CASE, :OTHERWISE) is already
terminated here: an unterminated `:EXITCASE` before `:OTHERWISE` is left
unterminated and trips the invariants (reported separately).
-- input.ssl --
:PROCEDURE Terminate
:PARAMETERS nValue
:DECLARE sLabel, aList, fnDouble, nCount;
nCount := 0
sLabel := "start"
aList := {1, 2}
fnDouble := {|n| n * 2}
nCount++
:BEGINCASE
:CASE nValue == 1;
sLabel := Upper(sLabel)
:EXITCASE;
:OTHERWISE;
sLabel := ""
:EXITCASE;
:ENDCASE
:RETURN sLabel
:ENDPROC
-- format --
:PROCEDURE Terminate;
	:PARAMETERS nValue;
	:DECLARE sLabel, aList, fnDouble, nCount;

	nCount := 0;
	sLabel := "start";
	aList := {1, 2};
	fnDouble := {|n| n * 2};
	nCount++;

	:BEGINCASE;
	:CASE nValue == 1;
		sLabel := Upper(sLabel);
		:EXITCASE;
	:OTHERWISE;
		sLabel := "";
		:EXITCASE;
	:ENDCASE;

	:RETURN sLabel;
:ENDPROC;
