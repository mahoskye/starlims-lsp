Unary `-` after `:=`, an operator, an opening delimiter or a comma, and
`!`, `++`, `--`, written with and without a space before the operand;
no space is added after `(` or before `)` / `;` (fmt.operator_spacing
exceptions). Unary `+` is left out: the parser rejects it.
-- input.ssl --
:PROCEDURE Unary;
:PARAMETERS nA;
:DECLARE nR, aR, bR;
nR := - 5;
nR := nA * - 1;
nR := nA*-1;
aR := { -1, - nA };
DoProc("Offset", { - nA, nR });
nA ++;
nA--;
++ nA;
bR := ! bR;
bR := !bR;
nR := ( nA + 1 ) * ( nA - 1 ) ;
:RETURN nR;
:ENDPROC;
-- format --
:PROCEDURE Unary;
	:PARAMETERS nA;
	:DECLARE nR, aR, bR;
	nR := -5;
	nR := nA * -1;
	nR := nA * -1;
	aR := {-1, -nA};
	DoProc("Offset", {-nA, nR});
	nA++;
	nA--;
	++nA;
	bR := !bR;
	bR := !bR;
	nR := (nA + 1) * (nA - 1);
	:RETURN nR;
:ENDPROC;
-- diagnostics --
-- diagnostics [--strict --info] --
