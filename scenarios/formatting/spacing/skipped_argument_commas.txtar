Skipped arguments: adjacent commas stay tight and the last comma of the
run still gets its space before the next value (`{a,, b}`); a spaced run
`, ,` collapses to the tight form; a comma right before a closer takes no
space (fmt.comma_spacing issue #218; style guide skip_commas_adjacent).
-- input.ssl --
:PROCEDURE Skips;
:PARAMETERS sStatus, sSampleId;
:DECLARE vResult, bOk;
vResult := DoProc("MyProc", {sStatus,,sSampleId});
vResult := DoProc("MyProc", {sStatus, , sSampleId});
vResult := DoProc("MyProc", {sStatus,, , sSampleId});
bOk := RunSQL("UPDATE sample SET status = ? WHERE id = ?" , , {sStatus, sSampleId});
vResult := LSearch("SELECT name FROM sample WHERE id = ?",,  , {sSampleId});
vResult := DoProc("Trailing", {sStatus,,});
:RETURN vResult;
:ENDPROC;
-- format --
:PROCEDURE Skips;
	:PARAMETERS sStatus, sSampleId;
	:DECLARE vResult, bOk;
	vResult := DoProc("MyProc", {sStatus,, sSampleId});
	vResult := DoProc("MyProc", {sStatus,, sSampleId});
	vResult := DoProc("MyProc", {sStatus,,, sSampleId});
	bOk := RunSQL("UPDATE sample SET status = ? WHERE id = ?",, {sStatus, sSampleId});
	vResult := LSearch("SELECT name FROM sample WHERE id = ?",,, {sSampleId});
	vResult := DoProc("Trailing", {sStatus,,});
	:RETURN vResult;
:ENDPROC;
