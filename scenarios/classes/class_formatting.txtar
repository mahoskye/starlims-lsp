Class formatting from legacy casing and flat indentation: :CLASS,
:INHERIT and class-level :DECLARE stay at column 0 (a class has no end
keyword, so its members do not indent), method bodies indent one level,
nested blocks inside methods indent further, and keywords are uppercased
(fmt.keyword_case, fmt.indent_style). Space and tab variants.
-- input.ssl --
:class Inventory;
:inherit Lab.Store;
:declare aStock, nReorderAt;
:procedure Constructor;
:parameters nLevel;
:default nLevel, 5;
Me:nReorderAt := nLevel;
Me:aStock := {};
:endproc;
:procedure NeedsReorder;
:declare i, aLow;
aLow := {};
:for i := 1 :to Len(Me:aStock);
:if Me:aStock[i][2] < Me:nReorderAt;
AAdd(aLow, Me:aStock[i][1]);
:endif;
:next;
:return aLow;
:endproc;
-- format --
:CLASS Inventory;
:INHERIT Lab.Store;
:DECLARE aStock, nReorderAt;
:PROCEDURE Constructor;
	:PARAMETERS nLevel;
	:DEFAULT nLevel, 5;
	Me:nReorderAt := nLevel;
	Me:aStock := {};
:ENDPROC;

:PROCEDURE NeedsReorder;
	:DECLARE i, aLow;
	aLow := {};
	:FOR i := 1 :TO Len(Me:aStock);
		:IF Me:aStock[i][2] < Me:nReorderAt;
			AAdd(aLow, Me:aStock[i][1]);
		:ENDIF;
	:NEXT;
	:RETURN aLow;
:ENDPROC;
