-- format [--indent-style space --indent-size 2] --
:CLASS Inventory;
:INHERIT Lab.Store;
:DECLARE aStock, nReorderAt;
:PROCEDURE Constructor;
  :PARAMETERS nLevel;
  :DEFAULT nLevel, 5;
  Me:nReorderAt := nLevel;
  Me:aStock := {};
:ENDPROC;

:PROCEDURE NeedsReorder;
  :DECLARE i, aLow;
  aLow := {};
  :FOR i := 1 :TO Len(Me:aStock);
    :IF Me:aStock[i][2] < Me:nReorderAt;
      AAdd(aLow, Me:aStock[i][1]);
    :ENDIF;
  :NEXT;
  :RETURN aLow;
:ENDPROC;
