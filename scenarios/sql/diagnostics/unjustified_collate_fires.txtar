:PROCEDURE Names;
	:DECLARE aRows;
	aRows := SQLExecute("SELECT custname FROM customers ORDER BY custname COLLATE Latin1_General_CI_AS");
	:RETURN aRows;
:ENDPROC;
-- format --
:PROCEDURE Names;
	:DECLARE aRows;
	aRows := SQLExecute("
	    SELECT custname
	    FROM customers
	    ORDER BY custname COLLATE Latin1_General_CI_AS
	");
	:RETURN aRows;
:ENDPROC;
