Shapes named_sql_param_unsupported must leave alone
(diag.named_sql_param_unsupported Does not flag): named markers in
SQLExecute (the supported form), positional markers with value arrays in
the positional family, a member call oDb:RunSQL(...) that is the
object's own method (D10), and a ?name? string that is not the first
argument of a positional call.
-- input.ssl --
:PROCEDURE UpdateStatus;
	:PARAMETERS sStatus, sOrdNo, oDb;
	:DECLARE bOk, sName, aRows;
	aRows := SQLExecute("SELECT ordno FROM orders WHERE status = ?sStatus?");
	bOk := RunSQL("UPDATE orders SET status = ? WHERE ordno = ?",, {sStatus, sOrdNo});
	sName := LSearch("SELECT custname FROM orders WHERE ordno = ?", "",, {sOrdNo});
	aRows := LSelect1("SELECT ordno FROM orders WHERE status = ?",, {sStatus});
	bOk := oDb:RunSQL("UPDATE orders SET status = ?sStatus?");
	sName := LSearch("SELECT custname FROM orders WHERE ordno = ?", "?sOrdNo?",, {sOrdNo});
	:RETURN {bOk, sName, aRows};
:ENDPROC;
-- format --
:PROCEDURE UpdateStatus;
	:PARAMETERS sStatus, sOrdNo, oDb;
	:DECLARE bOk, sName, aRows;
	aRows := SQLExecute("SELECT ordno FROM orders WHERE status = ?sStatus?");
	bOk := RunSQL("UPDATE orders SET status = ? WHERE ordno = ?",, {sStatus, sOrdNo});
	sName := LSearch("SELECT custname FROM orders WHERE ordno = ?", "",, {sOrdNo});
	aRows := LSelect1("SELECT ordno FROM orders WHERE status = ?",, {sStatus});
	bOk := oDb:RunSQL("UPDATE orders SET status = ?sStatus?");
	sName := LSearch("SELECT custname FROM orders WHERE ordno = ?", "?sOrdNo?",,
	                 {sOrdNo});
	:RETURN {bOk, sName, aRows};
:ENDPROC;
-- diagnostics --
