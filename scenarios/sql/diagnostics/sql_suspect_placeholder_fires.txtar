-- format --
:PROCEDURE Stamp;
	:DECLARE aRows;

	aRows := SQLExecute("
	    INSERT INTO auditlog (
	        who, what
	    )
	    VALUES (
	        ?'<<username>>'?, 'login'
	    )
	");

	:RETURN aRows;
:ENDPROC;
