SQLExecute named placeholders that hold arithmetic or concatenation
(diag.complex_sql_placeholder): one on a single-line string, one on a
later line of a multi-line string, where the range must sit on the
placeholder's own line (issue #255). Info tier, so only the
[--strict --info] profile reports it.
-- input.ssl --
:PROCEDURE LoadByKey;
	:PARAMETERS sPrefix, sSuffix, nBase;
	:DECLARE aRows, aLater;
	aRows := SQLExecute("SELECT ordno, status FROM orders WHERE ordkey = ?sPrefix + sSuffix?");
	aLater := SQLExecute("
	    SELECT ordno, status
	    FROM orders
	    WHERE ordseq > ?nBase * 2?
	");
	:RETURN {aRows, aLater};
:ENDPROC;
-- format --
:PROCEDURE LoadByKey;
	:PARAMETERS sPrefix, sSuffix, nBase;
	:DECLARE aRows, aLater;

	aRows := SQLExecute("
	    SELECT ordno, status
	    FROM orders
	    WHERE ordkey = ?sPrefix + sSuffix?
	");
	aLater := SQLExecute("
	    SELECT ordno, status
	    FROM orders
	    WHERE ordseq > ?nBase * 2?
	");

	:RETURN {aRows, aLater};
:ENDPROC;
-- diagnostics --
-- diagnostics [--strict --info] --
4:71-4:90 info complex_sql_placeholder: Complex expression '?sPrefix + sSuffix?' in SQLExecute placeholder is evaluated on every execution. Pre-compute into a variable for better performance.
8:21-8:32 info complex_sql_placeholder: Complex expression '?nBase * 2?' in SQLExecute placeholder is evaluated on every execution. Pre-compute into a variable for better performance.
