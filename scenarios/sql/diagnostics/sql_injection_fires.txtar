Runtime values concatenated into the first argument of a SQL function
(diag.sql_injection, warning): a quoted splice in SQLExecute, a variable
SQL prefix with a constant tail in LSearch, a runtime operand after a
safe BuildStringForIn(...) operand, a leading function call seen
through, and a RunSQL splice. The info tier adds sql_literal_splice on
the quoted splice, deliberately.
-- input.ssl --
:PROCEDURE Lookup;
	:PARAMETERS sName, aIds, sAnd;
	:DECLARE sSQL, aRows, sFound, bOk;
	sSQL := "SELECT custid FROM customers";
	aRows := SQLExecute("SELECT custid FROM customers WHERE custname = '" + sName + "'");
	sFound := LSearch(sSQL + " WHERE status = 'OPEN'", "");
	aRows := SQLExecute("SELECT id FROM c WHERE id IN " + BuildStringForIn(aIds) + sAnd);
	aRows := SQLExecute(Upper(sSQL) + " WHERE custname = ?sName?");
	bOk := RunSQL("DELETE FROM customers WHERE custid = " + LimsString(aIds[1]));
	:RETURN {aRows, sFound, bOk};
:ENDPROC;
-- format --
:PROCEDURE Lookup;
	:PARAMETERS sName, aIds, sAnd;
	:DECLARE sSQL, aRows, sFound, bOk;
	sSQL := "SELECT custid FROM customers";
	aRows := SQLExecute("SELECT custid FROM customers WHERE custname = '" + sName + "'");
	sFound := LSearch(sSQL + " WHERE status = 'OPEN'", "");
	aRows := SQLExecute("SELECT id FROM c WHERE id IN " + BuildStringForIn(aIds) + sAnd);
	aRows := SQLExecute(Upper(sSQL) + " WHERE custname = ?sName?");
	bOk := RunSQL("DELETE FROM customers WHERE custid = " + LimsString(aIds[1]));
	:RETURN {aRows, sFound, bOk};
:ENDPROC;
