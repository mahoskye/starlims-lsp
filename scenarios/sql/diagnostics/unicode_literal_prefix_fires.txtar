N'…' Unicode literals in embedded SQL (diag.unicode_literal_prefix, info
tier), upper- and lowercase prefix, via SQLExecute and RunSQL.
-- input.ssl --
:PROCEDURE Notes;
	:PARAMETERS nId;
	:DECLARE aRows, bOk;
	aRows := SQLExecute("UPDATE samples SET note = N'checked' WHERE sampleid = ?nId?");
	bOk := RunSQL("UPDATE samples SET note = n'rechecked' WHERE sampleid = ?",, {nId});
	:RETURN {aRows, bOk};
:ENDPROC;
-- format --
:PROCEDURE Notes;
	:PARAMETERS nId;
	:DECLARE aRows, bOk;

	aRows := SQLExecute("UPDATE samples SET note = N'checked' WHERE sampleid = ?nId?");
	bOk := RunSQL("UPDATE samples SET note = n'rechecked' WHERE sampleid = ?",, {nId});

	:RETURN {aRows, bOk};
:ENDPROC;
