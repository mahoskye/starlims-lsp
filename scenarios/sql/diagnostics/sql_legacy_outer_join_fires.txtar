The Oracle (+) outer-join marker (diag.sql_legacy_outer_join, info
tier), which here also rides on a comma join (sql_comma_join): the two
advisories usually fire together.
-- input.ssl --
:PROCEDURE Outer;
	:DECLARE aRows;
	aRows := SQLExecute("SELECT o.ordno, r.result_value FROM orders o, ordresult r WHERE o.ordno = r.ordno(+)");
	:RETURN aRows;
:ENDPROC;
-- format --
:PROCEDURE Outer;
	:DECLARE aRows;

	aRows := SQLExecute("
	    SELECT o.ordno, r.result_value
	    FROM orders o, ordresult r
	    WHERE o.ordno = r.ordno(+)
	");

	:RETURN aRows;
:ENDPROC;
-- diagnostics --
-- diagnostics [--strict --info] --
3:22-3:108 info sql_comma_join: Comma join in FROM clause - ANSI JOIN ... ON syntax keeps each join condition next to its table and the WHERE clause for real filters
3:22-3:108 info sql_legacy_outer_join: Oracle (+) outer-join marker - ANSI LEFT/RIGHT JOIN is dialect-portable and keeps the join direction readable
