Named ?name? placeholders passed to the positional-only family
(diag.named_sql_param_unsupported, error): RunSQL, LSearch, LSelect1,
LSelect and GetDataSet each get one; the function name match is
case-insensitive (lsearch). At most one finding per string.
-- input.ssl --
:PROCEDURE UpdateStatus;
	:PARAMETERS sStatus, sOrdNo;
	:DECLARE bOk, sName, aRows, aAll, sXml;
	bOk := RunSQL("UPDATE orders SET status = ?sStatus? WHERE ordno = ?sOrdNo?");
	sName := lsearch("SELECT custname FROM orders WHERE ordno = ?sOrdNo?", "");
	aRows := LSelect1("SELECT ordno FROM orders WHERE status = ?sStatus?");
	aAll := LSelect("SELECT ordno FROM orders WHERE status = ?sStatus?");
	sXml := GetDataSet("SELECT ordno FROM orders WHERE status = ?sStatus?");
	:RETURN {bOk, sName, aRows, aAll, sXml};
:ENDPROC;
-- format --
:PROCEDURE UpdateStatus;
	:PARAMETERS sStatus, sOrdNo;
	:DECLARE bOk, sName, aRows, aAll, sXml;

	bOk := RunSQL("UPDATE orders SET status = ?sStatus? WHERE ordno = ?sOrdNo?");
	sName := LSearch("SELECT custname FROM orders WHERE ordno = ?sOrdNo?", "");
	aRows := LSelect1("SELECT ordno FROM orders WHERE status = ?sStatus?");
	aAll := LSelect("SELECT ordno FROM orders WHERE status = ?sStatus?");
	sXml := GetDataSet("SELECT ordno FROM orders WHERE status = ?sStatus?");

	:RETURN {bOk, sName, aRows, aAll, sXml};
:ENDPROC;
