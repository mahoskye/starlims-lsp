MERGE in SSL (reference §2.12, §7.4, sql_merge_layout): MERGE INTO,
USING, ON and the WHEN branches at the clause column, UPDATE SET /
INSERT indented 4 under WHEN, the USING inline view laid out flat.
-- input.ssl --
:PROCEDURE Summarize;
	:PARAMETERS sOrdNo;
	:DECLARE bOk;
	bOk := RunSQL("merge into ordtask_summary tgt using (select ordno, testcode, count(*) as cnt from ordresult where ordno = ? group by ordno, testcode) src on (tgt.ordno = src.ordno and tgt.testcode = src.testcode) when matched then update set tgt.result_count = src.cnt, tgt.updated_date = sysdate when not matched then insert (ordno, testcode, result_count, created_date) values (src.ordno, src.testcode, src.cnt, sysdate)",, {sOrdNo});
	:RETURN bOk;
:ENDPROC;
-- format --
:PROCEDURE Summarize;
	:PARAMETERS sOrdNo;
	:DECLARE bOk;
	bOk := RunSQL("
	    MERGE INTO ordtask_summary tgt
	    USING (
	        SELECT ordno, testcode, COUNT(*) AS cnt
	        FROM ordresult
	        WHERE ordno = ?
	        GROUP BY ordno, testcode
	    ) src
	    ON (tgt.ordno = src.ordno AND tgt.testcode = src.testcode)
	    WHEN MATCHED THEN
	        UPDATE SET tgt.result_count = src.cnt,
	                   tgt.updated_date = SYSDATE
	    WHEN NOT MATCHED THEN
	        INSERT (
	            ordno, testcode, result_count, created_date
	        )
	        VALUES (
	            src.ordno, src.testcode, src.cnt, SYSDATE
	        )
	",, {sOrdNo});
	:RETURN bOk;
:ENDPROC;
