format [--no-sql] disables embedded-SQL formatting: an overflowing SQL
string is byte-preserved while the surrounding SSL (keyword case,
indentation) is still formatted. The default format section shows the
same input with SQL formatting on.
-- input.ssl --
:procedure Off;
:parameters sStatus;
:declare aRows;
aRows := SQLExecute("select sample_id, sample_name, sample_status from samples where sample_status = ?sStatus? order by sample_id");
:return aRows;
:endproc;
-- format [--no-sql] --
:PROCEDURE Off;
	:PARAMETERS sStatus;
	:DECLARE aRows;
	aRows := SQLExecute("select sample_id, sample_name, sample_status from samples where sample_status = ?sStatus? order by sample_id");
	:RETURN aRows;
:ENDPROC;
-- format --
:PROCEDURE Off;
	:PARAMETERS sStatus;
	:DECLARE aRows;
	aRows := SQLExecute("
	    SELECT sample_id, sample_name, sample_status
	    FROM samples
	    WHERE sample_status = ?sStatus?
	    ORDER BY sample_id
	");
	:RETURN aRows;
:ENDPROC;
-- diagnostics --
1:1-1:11 error keyword_uppercase: SSL keywords are case-sensitive and must be uppercase: use ':PROCEDURE'
2:1-2:12 error keyword_uppercase: SSL keywords are case-sensitive and must be uppercase: use ':PARAMETERS'
3:1-3:9 error keyword_uppercase: SSL keywords are case-sensitive and must be uppercase: use ':DECLARE'
5:1-5:8 error keyword_uppercase: SSL keywords are case-sensitive and must be uppercase: use ':RETURN'
6:1-6:9 error keyword_uppercase: SSL keywords are case-sensitive and must be uppercase: use ':ENDPROC'
-- diagnostics [--strict --info] --
