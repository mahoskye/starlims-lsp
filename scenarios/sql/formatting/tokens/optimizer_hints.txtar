Oracle optimizer hints (/*+ … */) are kept right after SELECT and never
stripped or re-cased as comments (reference §4.7, sql_optimizer_hints).
-- input.ssl --
:PROCEDURE Hinted;
	:PARAMETERS sStatus;
	:DECLARE aRows;
	aRows := SQLExecute("select /*+ index(t idx_ordtask_status) */ t.ordno, t.testcode, t.status from ordtask t where t.status = ?sStatus? order by t.ordno");
	:RETURN aRows;
:ENDPROC;
-- format --
:PROCEDURE Hinted;
	:PARAMETERS sStatus;
	:DECLARE aRows;
	aRows := SQLExecute("
	    SELECT /*+ index(t idx_ordtask_status) */ t.ordno, t.testcode, t.status
	    FROM ordtask t
	    WHERE t.status = ?sStatus?
	    ORDER BY t.ordno
	");
	:RETURN aRows;
:ENDPROC;
