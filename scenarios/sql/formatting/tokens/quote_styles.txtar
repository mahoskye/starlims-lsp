The three SSL string delimiters: a double-quoted string and a
bracket-quoted string holding single-quoted SQL literals both reflow,
the bracket string closing with ']' (issue #81); a single-quoted SSL
string holding double-quoted SQL identifiers is recorded as-is.
-- input.ssl --
:PROCEDURE Quotes;
	:PARAMETERS sStatus;
	:DECLARE aOne, aTwo, aThree;
	aOne := SQLExecute("select ordno, status, logdate from orders where status = 'A' and site = 'LAB1' order by logdate");
	aTwo := SQLExecute('select "OrdNo", "MixedCase" from "Orders" where "Status" = ?sStatus? and logdate > sysdate - 7');
	aThree := SQLExecute([select ordno, description from orders where description like 'QC%' and status in ('A', 'B') order by ordno]);
	:RETURN {aOne, aTwo, aThree};
:ENDPROC;
-- format --
:PROCEDURE Quotes;
	:PARAMETERS sStatus;
	:DECLARE aOne, aTwo, aThree;

	aOne := SQLExecute("
	    SELECT ordno, status, logdate
	    FROM orders
	    WHERE status = 'A'
	      AND site = 'LAB1'
	    ORDER BY logdate
	");
	aTwo := SQLExecute('
	    SELECT "OrdNo", "MixedCase"
	    FROM "Orders"
	    WHERE "Status" = ?sStatus?
	      AND logdate > SYSDATE - 7
	');
	aThree := SQLExecute([
	    SELECT ordno, description
	    FROM orders
	    WHERE description LIKE 'QC%'
	      AND status IN ('A', 'B')
	    ORDER BY ordno
	]);

	:RETURN {aOne, aTwo, aThree};
:ENDPROC;
-- diagnostics --
-- diagnostics [--strict --info] --
