Subqueries follow the flat convention in every context (reference §2.6):
an IN subquery and an EXISTS subquery in WHERE, a scalar subquery in the
SELECT list, and an inline view in FROM each open '(' on the parent
line, indent the body one level, and close ')' at the clause column.
-- input.ssl --
:PROCEDURE Nested;
	:DECLARE aRows, aMore;
	aRows := SQLExecute("select o.ordno, (select count(*) from ordtask t where t.ordno = o.ordno) as task_count from orders o where o.custid in (select c.custid from customers c where c.active = 'Y') and exists (select 1 from ordresult r where r.ordno = o.ordno and r.status = 'Failed')");
	aMore := SQLExecute("select v.testcode, v.task_count from (select testcode, count(*) as task_count from ordtask where status = 'Complete' group by testcode) v where v.task_count > 10 order by v.task_count desc");
	:RETURN {aRows, aMore};
:ENDPROC;
-- format --
:PROCEDURE Nested;
	:DECLARE aRows, aMore;
	aRows := SQLExecute("
	    SELECT o.ordno, (
	        SELECT COUNT(*)
	        FROM ordtask t
	        WHERE t.ordno = o.ordno
	    ) AS task_count
	    FROM orders o
	    WHERE o.custid IN (
	        SELECT c.custid
	        FROM customers c
	        WHERE c.active = 'Y'
	    )
	      AND EXISTS (
	        SELECT 1
	        FROM ordresult r
	        WHERE r.ordno = o.ordno
	          AND r.status = 'Failed'
	    )
	");
	aMore := SQLExecute("
	    SELECT v.testcode, v.task_count
	    FROM (
	        SELECT testcode, COUNT(*) AS task_count
	        FROM ordtask
	        WHERE status = 'Complete'
	        GROUP BY testcode
	    ) v
	    WHERE v.task_count > 10
	    ORDER BY v.task_count DESC
	");
	:RETURN {aRows, aMore};
:ENDPROC;
