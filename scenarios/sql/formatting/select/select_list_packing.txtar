A long SELECT list packs columns onto lines up to the limit, with
continuation lines aligned under the first column (reference §2.1,
sql_select_packing / sql_select_continuation), DISTINCT kept on the
SELECT line, and function calls kept whole.
Suspected issue: #327 — the packed SELECT line reaches 94 columns (tab = 4) inside the procedure; the SQL engine's 90-column budget appears to ignore the SSL statement indent, while the fits-inline test in fmt.sql_in_strings measures the line as written ("fits within ssl.format.maxLineLength on its current line"). Same effect in select/case_outside_select_list (92) and select/cte_and_window (91).
-- input.ssl --
:PROCEDURE Wide;
	:DECLARE aRows;
	aRows := SQLExecute("select distinct o.ordno, o.custid, o.logdate, o.duedate, o.status, o.site, o.priority, upper(o.description) as description_upper, coalesce(o.comments, 'none') as comments from orders o where o.status = 'A'");
	:RETURN aRows;
:ENDPROC;
-- format --
:PROCEDURE Wide;
	:DECLARE aRows;
	aRows := SQLExecute("
	    SELECT DISTINCT o.ordno, o.custid, o.logdate, o.duedate, o.status, o.site, o.priority,
	           UPPER(o.description) AS description_upper,
	           COALESCE(o.comments, 'none') AS comments
	    FROM orders o
	    WHERE o.status = 'A'
	");
	:RETURN aRows;
:ENDPROC;
-- diagnostics --
-- diagnostics [--strict --info] --
