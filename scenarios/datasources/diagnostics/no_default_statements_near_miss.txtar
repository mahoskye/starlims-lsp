Near miss for no_default_statements_in_datasource: the inline form inside
:PARAMETERS is the correct data-source default, and the word DEFAULT in a
SQL string and in a comment is not the keyword.
-- input.ds --
/* uses the DEFAULT aisle when none is given;
:PARAMETERS sAisle := "DEFAULT";
:DECLARE aRows;
aRows := SQLExecute("SELECT aisle_id FROM aisle WHERE aisle_code = ?sAisle? OR aisle_code = 'DEFAULT'");
:RETURN aRows;
-- format --
/* uses the DEFAULT aisle when none is given;
:PARAMETERS sAisle := "DEFAULT";
:DECLARE aRows;

aRows := SQLExecute("
    SELECT aisle_id
    FROM aisle
    WHERE aisle_code = ?sAisle?
      OR aisle_code = 'DEFAULT'
");

:RETURN aRows;
-- diagnostics --
-- diagnostics [--strict --info] --
