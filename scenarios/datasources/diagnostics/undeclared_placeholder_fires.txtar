datasource_undeclared_placeholder: in the hybrid shape a @name placeholder
with no case-insensitive match among the header's :PARAMETERS warns, most
often a typo of a declared name (`@sFolder` for sFolderNo), ranged over
the full span with the header offset applied.
-- input.ds --
:DSN := DATABASE;
:PARAMETERS sFolderNo := "";

select doc_id, doc_title
from folder_doc
where folder_no = @sFolder
-- format --
:DSN := DATABASE;
:PARAMETERS sFolderNo := "";

select doc_id, doc_title
from folder_doc
where folder_no = @sFolder
